# ============================================================
# TalentoVe — variables de entorno de la instalación
# Toda variable es obligatoria y se valida con fail-fast al
# arrancar (zod). Copiar a .env y ajustar valores.
#
# Solo hay secretos aquí: la configuración de negocio (branding,
# terminología, módulos, parámetros legales) vive en la tabla
# `settings` y en `rate_tables`/`rule_sets`, es editable por UI y
# NO va en este archivo (ver docs/arquitectura.md §6).
# ============================================================

# --- Aplicación ---
NODE_ENV=development
PORT=3000
BASE_URL=http://localhost:3000
TZ=America/Caracas
# Etiqueta de la instalación (aparece en logs y en /health)
INSTANCE_NAME=mi-instalacion

# --- PostgreSQL (única dependencia fuerte de servicio) ---
DATABASE_URL=postgres://talento:CAMBIAR@localhost:5432/talento
# Límites del pool (ajustar según RAM del servidor de la empresa)
DATABASE_POOL_MAX=10
DATABASE_POOL_IDLE_TIMEOUT_MS=30000

# --- Sesiones y seguridad ---
# Secreto maestro de la instalación — generar con: openssl rand -hex 32
# IMPORTANTE: la app RECHAZA valores de ejemplo (CAMBIAR, changeme, secret,
# password) y exige al menos 32 bytes hex: un placeholder que pasa la
# validación produciría sesiones firmadas con una clave conocida.
# De este secreto se derivan por HKDF el firmador de cookies de sesión y el
# de los tokens CSRF: no hay un segundo secreto que se pueda olvidar.
SESSION_SECRET=CAMBIAR
# Nombre de la cookie de sesión
SESSION_COOKIE_NAME=tv_sid
# Duración absoluta de una sesión
SESSION_TTL_HOURS=12
# Sesión inactiva: aviso y luego cierre (patrón Patria, valores por defecto)
SESSION_INACTIVE_WARNING_MINUTES=8
SESSION_INACTIVE_LOGOUT_MINUTES=10
# Credenciales de rate limiting en login (intentos por ventana)
LOGIN_RATE_LIMIT_MAX=10
LOGIN_RATE_LIMIT_WINDOW_MINUTES=15

# --- Correo saliente (comunicados, notificaciones, recibos) ---
# Si SMTP_HOST queda vacío, la instalación arranca sin correo y la
# UI lo advierte (las notificaciones in-app siguen funcionando).
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM=rrhh@miempresa.ve
MAIL_FROM_NAME=RRHH

# --- Almacenamiento de documentos (driver) ---
# Opciones: local (por defecto) | s3
STORAGE_DRIVER=local
STORAGE_LOCAL_PATH=./uploads
# Tamaño máximo por archivo, en bytes (por defecto 10 MB)
STORAGE_MAX_FILE_BYTES=10485760
# Tipos MIME permitidos para carga (lista separada por comas)
STORAGE_ALLOWED_MIME=application/pdf,image/jpeg,image/png

# Opcional: almacenamiento S3/MinIO (requiere STORAGE_DRIVER=s3)
# S3_ENDPOINT=
# S3_REGION=
# S3_BUCKET=
# S3_ACCESS_KEY=
# S3_SECRET_KEY=

# --- Parámetros legales iniciales ---
# Solo se usan para el primer arranque cuando la BD está vacía
# (semilla de rate_tables). Después, la fuente de verdad es la UI
# de parámetros legales, con vigencia y fuente por registro.
# Tasa BCV inicial de arranque (formato: número decimal, sin separadores)
# INITIAL_BCV_USD_RATE=
