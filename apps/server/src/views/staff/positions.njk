{% extends "layouts/base.njk" %}

{% block content %}
<div class="page-header">
  <div class="page-header-content">
    <div class="page-header-icon" style="background: #faf5ff; color: #9333ea;">📋</div>
    <div>
      <h1 class="page-header-title">Gestión de Cargos</h1>
      <p class="page-header-subtitle">Crea y administra los cargos de la institución.</p>
    </div>
  </div>
  <div class="page-header-actions">
    <a href="/personal" class="btn btn-outline">&larr; Volver</a>
  </div>
</div>

{% if success %}
  <div class="alert-success">{{ success }}</div>
{% endif %}

<div style="display: grid; grid-template-columns: 2fr 1.2fr; gap: 1.5rem; align-items: start;">
  <!-- Tabla de Cargos -->
  <div class="qrh-table-card">
    <div style="padding: 1.25rem 1.5rem; border-bottom: 1px solid var(--border-color); display: flex; justify-content: space-between; align-items: center;">
      <h3 style="font-size: 1.1rem; font-weight: 700; margin: 0; color: var(--text-color);">Cargos Configurados</h3>
      <span class="qrh-badge">{{ positions.length }} cargos</span>
    </div>

    <table class="qrh-table">
      <thead>
        <tr>
          <th>Nombre del Cargo</th>
          <th>Categoría</th>
          <th>Sector</th>
          <th>Tabulador APN</th>
          <th scope="col" style="text-align: right;">Estado</th>
        </tr>
      </thead>
      <tbody>
        {% if positions.length == 0 %}
          <tr>
            <td colspan="5" style="text-align: center; color: var(--text-muted); padding: 2rem;">
              No hay cargos registrados aún. Añade el primero en el formulario derecho.
            </td>
          </tr>
        {% else %}
          {% for pos in positions %}
            <tr>
              <td style="font-weight: 600;">
                <div>{{ pos.name }}</div>
                {% if pos.codigo %}<small style="color: var(--text-muted); font-size: 0.75rem;">Cód: {{ pos.codigo }}</small>{% endif %}
              </td>
              <td>
                <span class="qrh-badge" style="background: #faf5ff; color: #7e22ce;">{{ pos.categoria }}</span>
              </td>
              <td style="font-size: 0.85rem; text-transform: capitalize;">{{ pos.aplicaSector }}</td>
              <td style="font-family: monospace; font-size: 0.825rem; color: #475569;">
                {{ pos.nivelTabuladorApn or '-' }}
              </td>
              <td style="text-align: right;">
                {% if pos.activo %}
                  <span style="color: #16a34a; font-weight: 700; font-size: 0.8rem;">Activo</span>
                {% else %}
                  <span style="color: #94a3b8; font-size: 0.8rem;">Inactivo</span>
                {% endif %}
              </td>
            </tr>
          {% endfor %}
        {% endif %}
      </tbody>
    </table>
  </div>

  <!-- Formulario de Añadir Cargo -->
  <div class="card" style="margin-bottom: 0;">
    <h3 style="font-size: 1.1rem; font-weight: 700; margin-bottom: 0.35rem; color: var(--text-color);">Añadir Cargo</h3>
    <p style="font-size: 0.825rem; color: var(--text-muted); margin-bottom: 1.25rem;">
      Define los puestos de trabajo y sus características asociadas en el clasificador laboral.
    </p>

    <form method="POST" action="/cargos">
      <div class="form-group">
        <label for="name">Nombre del Cargo *</label>
        <input type="text" id="name" name="name" class="form-control" placeholder="Ej: Analista de Recursos Humanos II" required>
      </div>

      <div class="form-group">
        <label for="categoria">Categoría Ocupacional *</label>
        <select id="categoria" name="categoria" class="form-control" required>
          <option value="Directivo / Gerencial">Directivo / Gerencial</option>
          <option value="Profesional">Profesional</option>
          <option value="Técnico" selected>Técnico</option>
          <option value="Administrativo">Administrativo</option>
          <option value="Obrero / Servicios">Obrero / Servicios</option>
          <option value="Médico / Asistencial">Médico / Asistencial</option>
        </select>
      </div>

      <div class="form-group">
        <label for="grupoIsco">Grupo ISCO (OIT)</label>
        <input type="text" id="grupoIsco" name="grupoIsco" value="3341" class="form-control" placeholder="Ej: 2423 o 3341">
      </div>

      <div class="form-group">
        <label for="aplicaSector">Sector de Aplicación *</label>
        <select id="aplicaSector" name="aplicaSector" class="form-control">
          <option value="ambos" selected>Ambos Sectores</option>
          <option value="publico">Sector Público (APN)</option>
          <option value="privado">Sector Privado</option>
        </select>
      </div>

      <div class="form-group">
        <label for="nivelTabuladorApn">Nivel Tabulador APN (opcional)</label>
        <input type="text" id="nivelTabuladorApn" name="nivelTabuladorApn" placeholder="Ej: B-1 / P-2 / T-1" class="form-control">
      </div>

      <button type="submit" class="btn btn-primary" style="width: 100%; justify-content: center; background: #9333ea; border-color: #9333ea;">
        ➕ Guardar Cargo
      </button>
    </form>
  </div>
</div>
{% endblock %}
