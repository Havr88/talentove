{% extends "layouts/base.njk" %}

{% block content %}
<div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 2rem;">
  <div>
    <h1 style="font-size: 1.75rem; color: var(--primary-color);">Bandeja de Solicitudes y Autoservicio</h1>
    <p style="color: var(--text-muted);">Gestión de constancias de trabajo, anticipos de prestaciones, permisos y vacaciones</p>
  </div>
  <div>
    <a href="/solicitudes/nueva" class="btn">➕ Radicar Solicitud</a>
  </div>
</div>

{% if success %}
  <div class="alert-success">{{ success }}</div>
{% endif %}
{% if error %}
  <div class="alert-error">{{ error }}</div>
{% endif %}

<div class="card" style="padding: 0; overflow: hidden;">
  <div style="padding: 1rem 1.5rem; background: #fafafa; border-bottom: 1px solid var(--border-color); display: flex; justify-content: space-between; align-items: center;">
    <span style="font-weight: 600; color: var(--text-color);">Total: {{ requests.length }} solicitudes</span>
  </div>

  <table style="width: 100%; border-collapse: collapse; text-align: left; font-size: 0.95rem;">
    <thead>
      <tr style="background-color: #f5f5f5; border-bottom: 1px solid var(--border-color);">
        <th style="padding: 0.85rem 1.25rem;">Fecha</th>
        <th style="padding: 0.85rem 1.25rem;">Trabajador</th>
        <th style="padding: 0.85rem 1.25rem;">Tipo de Solicitud</th>
        <th style="padding: 0.85rem 1.25rem;">Detalle / Motivo</th>
        <th style="padding: 0.85rem 1.25rem;">Estatus</th>
        <th style="padding: 0.85rem 1.25rem; text-align: right;">Acciones</th>
      </tr>
    </thead>
    <tbody>
      {% for req in requests %}
        <tr style="border-bottom: 1px solid var(--border-color);">
          <td style="padding: 0.85rem 1.25rem; color: var(--text-muted); font-size: 0.85rem;">{{ req.createdAt | formatDate }}</td>
          <td style="padding: 0.85rem 1.25rem; font-weight: 600;">
            <a href="/trabajadores/{{ req.employeeId }}" style="color: var(--primary-color); text-decoration: none;">
              {{ req.employeeName }} ({{ req.employeeCedula }})
            </a>
          </td>
          <td style="padding: 0.85rem 1.25rem; text-transform: capitalize;">
            <strong>{{ req.tipo | replace('_', ' ') }}</strong>
          </td>
          <td style="padding: 0.85rem 1.25rem; color: var(--text-color); max-width: 300px;">
            {{ req.motivo }}
            {% if req.montoSolicitado %}
              <div style="font-size: 0.85rem; color: #2e7d32; font-weight: 600;">Monto: VES {{ req.montoSolicitado }}</div>
            {% endif %}
            {% if req.fechaDesde %}
              <div style="font-size: 0.8rem; color: var(--text-muted);">Desde {{ req.fechaDesde }} hasta {{ req.fechaHasta }} ({{ req.diasSolicitados }} días)</div>
            {% endif %}
          </td>
          <td style="padding: 0.85rem 1.25rem;">
            {% if req.estatus == 'aprobada' %}
              <span style="display: inline-block; padding: 0.2rem 0.6rem; border-radius: 9999px; font-size: 0.8rem; font-weight: 600; background-color: #e8f5e9; color: #2e7d32;">
                Aprobada
              </span>
            {% elif req.estatus == 'rechazada' %}
              <span style="display: inline-block; padding: 0.2rem 0.6rem; border-radius: 9999px; font-size: 0.8rem; font-weight: 600; background-color: #ffebee; color: #c62828;">
                Rechazada
              </span>
            {% else %}
              <span style="display: inline-block; padding: 0.2rem 0.6rem; border-radius: 9999px; font-size: 0.8rem; font-weight: 600; background-color: #fff8e1; color: #f57f17;">
                Pendiente
              </span>
            {% endif %}
          </td>
          <td style="padding: 0.85rem 1.25rem; text-align: right;">
            {% if req.estatus == 'pendiente' and (currentUser.role == 'superadmin' or currentUser.role == 'admin') %}
              <div style="display: inline-flex; gap: 0.4rem;">
                <form action="/solicitudes/{{ req.id }}/aprobar" method="POST" style="display: inline;">
                  <input type="hidden" name="_csrf" value="{{ csrfToken }}">
                  <button type="submit" class="btn" style="padding: 0.25rem 0.6rem; font-size: 0.8rem; background-color: #2e7d32;">
                    Aprobar
                  </button>
                </form>
                <form action="/solicitudes/{{ req.id }}/rechazar" method="POST" style="display: inline;">
                  <input type="hidden" name="_csrf" value="{{ csrfToken }}">
                  <button type="submit" class="btn" style="padding: 0.25rem 0.6rem; font-size: 0.8rem; background-color: #c62828;">
                    Rechazar
                  </button>
                </form>
              </div>
            {% elif req.tipo == 'constancia_trabajo' and req.estatus == 'aprobada' %}
              <a href="/trabajadores/{{ req.employeeId }}/constancia/pdf" target="_blank" style="color: var(--primary-color); font-weight: 600; text-decoration: none; font-size: 0.85rem;">
                📄 Descargar PDF
              </a>
            {% else %}
              <span style="color: var(--text-muted); font-size: 0.85rem;">Sin acciones</span>
            {% endif %}
          </td>
        </tr>
      {% else %}
        <tr>
          <td colspan="6" style="padding: 2.5rem; text-align: center; color: var(--text-muted);">
            No hay solicitudes registradas en la bandeja.
          </td>
        </tr>
      {% endfor %}
    </tbody>
  </table>
</div>
{% endblock %}
