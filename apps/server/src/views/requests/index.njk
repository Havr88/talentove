{% extends "layouts/base.njk" %}

{% block content %}
<div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 2rem; flex-wrap: wrap; gap: 1rem;">
  <div>
    <h1 style="font-size: 1.85rem; font-weight: 800; color: var(--text-color); letter-spacing: -0.02em; margin: 0;">
      📝 Bandeja de Solicitudes y Trámites
    </h1>
    <p style="color: var(--text-muted); font-size: 0.95rem; margin-top: 0.25rem;">
      Constancias de trabajo digitales con QR, anticipos de prestaciones sociales (LOTTT Art. 144) y permisos.
    </p>
  </div>
  <div>
    <a href="/solicitudes/nueva" class="btn btn-primary">
      <span>➕</span> Radicar Solicitud
    </a>
  </div>
</div>

{% if success %}
  <div class="alert-success">
    <span>✓</span>
    <span>{{ success }}</span>
  </div>
{% endif %}
{% if error %}
  <div class="alert-error">
    <span>⚠️</span>
    <span>{{ error }}</span>
  </div>
{% endif %}

<div class="table-container">
  <div style="padding: 1.25rem 1.5rem; background: var(--card-bg); border-bottom: 1px solid var(--border-color); display: flex; justify-content: space-between; align-items: center;">
    <div style="display: flex; align-items: center; gap: 0.75rem;">
      <span style="font-weight: 700; color: var(--text-color); font-size: 1rem;">Historial de Solicitudes</span>
      <span class="badge badge-info">{{ requests.length }} radicadas</span>
    </div>
  </div>

  <table class="data-table">
    <thead>
      <tr>
        <th scope="col" style="width: 120px;">Fecha</th>
        <th>Trabajador</th>
        <th>Tipo de Trámite</th>
        <th>Detalle / Justificación</th>
        <th scope="col" style="width: 130px; text-align: center;">Estatus</th>
        <th scope="col" style="text-align: right; width: 170px;">Acciones</th>
      </tr>
    </thead>
    <tbody>
      {% for req in requests %}
        <tr>
          <td style="color: var(--text-muted); font-size: 0.85rem; white-space: nowrap;">
            {{ req.createdAt | formatDate }}
          </td>
          <td>
            <a href="/trabajadores/{{ req.employeeId }}" style="font-weight: 600; color: var(--primary-color);">
              {{ req.employeeName }}
            </a>
            <br>
            <small style="color: var(--text-muted); font-size: 0.8rem;">C.I. {{ req.employeeCedula }}</small>
          </td>
          <td>
            <span class="badge badge-neutral" style="text-transform: capitalize;">
              {{ req.tipo | replace('_', ' ') }}
            </span>
          </td>
          <td style="max-width: 320px;">
            <div style="font-size: 0.88rem; color: var(--text-color);">{{ req.motivo }}</div>
            {% if req.montoSolicitado %}
              <div style="font-size: 0.825rem; color: #16a34a; font-weight: 700; margin-top: 0.2rem;">
                Monto: VES {{ req.montoSolicitado }}
              </div>
            {% endif %}
            {% if req.fechaDesde %}
              <div style="font-size: 0.8rem; color: var(--text-muted); margin-top: 0.2rem;">
                📅 {{ req.fechaDesde }} al {{ req.fechaHasta }} ({{ req.diasSolicitados }} días)
              </div>
            {% endif %}
          </td>
          <td style="text-align: center;">
            {% if req.estatus == 'aprobada' %}
              <span class="badge badge-success"><span class="badge-dot"></span> Aprobada</span>
            {% elif req.estatus == 'rechazada' %}
              <span class="badge badge-danger"><span class="badge-dot"></span> Rechazada</span>
            {% else %}
              <span class="badge badge-warning"><span class="badge-dot"></span> Pendiente</span>
            {% endif %}
          </td>
          <td style="text-align: right; white-space: nowrap;">
            {% if req.estatus == 'pendiente' and (currentUser.role == 'superadmin' or currentUser.role == 'admin') %}
              <div style="display: inline-flex; gap: 0.35rem;">
                <form action="/solicitudes/{{ req.id }}/aprobar" method="POST" style="display: inline; margin: 0;">
                  <input type="hidden" name="_csrf" value="{{ csrfToken }}">
                  <button type="submit" class="btn btn-success btn-sm">
                    Aprobar
                  </button>
                </form>
                <form action="/solicitudes/{{ req.id }}/rechazar" method="POST" style="display: inline; margin: 0;">
                  <input type="hidden" name="_csrf" value="{{ csrfToken }}">
                  <button type="submit" class="btn btn-accent btn-sm">
                    Rechazar
                  </button>
                </form>
              </div>
            {% elif req.tipo == 'constancia_trabajo' and req.estatus == 'aprobada' %}
              <a href="/trabajadores/{{ req.employeeId }}/constancia/pdf" target="_blank" class="btn btn-outline btn-sm" style="font-weight: 600;">
                📄 PDF Oficial
              </a>
            {% else %}
              <span style="color: var(--text-subtle); font-size: 0.85rem;">—</span>
            {% endif %}
          </td>
        </tr>
      {% else %}
        <tr>
          <td colspan="6" style="padding: 3.5rem; text-align: center; color: var(--text-muted);">
            No hay solicitudes registradas en la bandeja.
          </td>
        </tr>
      {% endfor %}
    </tbody>
  </table>
</div>
{% endblock %}
