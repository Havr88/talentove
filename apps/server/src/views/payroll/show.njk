{% extends "layouts/base.njk" %}

{% block content %}
<div style="margin-bottom: 1.5rem;">
  <a href="/nomina" style="color: var(--text-muted); font-size: 0.875rem; display: inline-flex; align-items: center; gap: 0.25rem;">
    &larr; Volver a Lotes de Nómina
  </a>
  <div style="display: flex; justify-content: space-between; align-items: flex-start; margin-top: 0.5rem;">
    <div>
      <h1 style="font-size: 1.5rem; font-weight: 700; color: var(--text-color);">
        Lote de Nómina: {{ batch.periodStart }} &rarr; {{ batch.periodEnd }}
      </h1>
      <p style="color: var(--text-muted); font-size: 0.875rem;">
        Frecuencia: <strong>{{ "Quincenal" if batch.periodType == "FORTNIGHT" else "Mensual" }}</strong> &bull;
        Calculado el {{ batch.createdAt }} &bull;
        Responsable: {{ batch.createdBy }}
      </p>
    </div>
    <div style="display: flex; gap: 0.75rem; align-items: center;">
      <a href="/nomina/{{ batch.id }}/bancos" class="btn btn-outline" style="font-size: 0.85rem;">
        🏦 Dispersión Bancaria (TXT)
      </a>
      <a href="/nomina/{{ batch.id }}/parafiscales" class="btn btn-outline" style="font-size: 0.85rem;">
        📋 Archivos Parafiscales
      </a>
      <span class="badge" style="padding: 0.4rem 0.85rem; border-radius: 9999px; background: #dcfce7; color: #166534; font-weight: 700; font-size: 0.85rem;">
        {{ batch.status }}
      </span>
    </div>
  </div>
</div>

<!-- Resumen Financiero -->
<div style="display: grid; grid-template-columns: repeat(4, 1fr); gap: 1rem; margin-bottom: 1.5rem;">
  <div class="card" style="background: white; border: 1px solid var(--border-color); border-radius: var(--radius-md); padding: 1.25rem;">
    <div style="font-size: 0.75rem; text-transform: uppercase; color: var(--text-muted); font-weight: 700;">Trabajadores</div>
    <div style="font-size: 1.5rem; font-weight: 700; color: var(--text-color); margin-top: 0.25rem;">{{ batch.totalWorkers }}</div>
  </div>
  <div class="card" style="background: white; border: 1px solid var(--border-color); border-radius: var(--radius-md); padding: 1.25rem;">
    <div style="font-size: 0.75rem; text-transform: uppercase; color: var(--text-muted); font-weight: 700;">Total Devengado</div>
    <div style="font-size: 1.5rem; font-weight: 700; color: #0369a1; margin-top: 0.25rem;">{{ batch.totalGross }} Bs</div>
  </div>
  <div class="card" style="background: white; border: 1px solid var(--border-color); border-radius: var(--radius-md); padding: 1.25rem;">
    <div style="font-size: 0.75rem; text-transform: uppercase; color: var(--text-muted); font-weight: 700;">Total Deducciones</div>
    <div style="font-size: 1.5rem; font-weight: 700; color: #b91c1c; margin-top: 0.25rem;">-{{ batch.totalDeductions }} Bs</div>
  </div>
  <div class="card" style="background: #ecfdf5; border: 1px solid #a7f3d0; border-radius: var(--radius-md); padding: 1.25rem;">
    <div style="font-size: 0.75rem; text-transform: uppercase; color: #047857; font-weight: 700;">Neto a Pagar</div>
    <div style="font-size: 1.5rem; font-weight: 700; color: #065f46; margin-top: 0.25rem;">{{ batch.totalNet }} Bs</div>
  </div>
</div>

<!-- Tabla de Recibos Individuales -->
<div class="card" style="background: white; border: 1px solid var(--border-color); border-radius: var(--radius-lg); padding: 1.5rem; box-shadow: var(--shadow-sm);">
  <h2 style="font-size: 1.1rem; font-weight: 600; margin-bottom: 1rem; color: var(--text-color);">
    Recibos Individuales de Pago (Snapshots Inmutables)
  </h2>

  <div style="overflow-x: auto;">
    <table style="width: 100%; border-collapse: collapse; font-size: 0.875rem; text-align: left;">
      <thead>
        <tr style="border-bottom: 2px solid var(--border-color); color: var(--text-muted);">
          <th scope="col" style="padding: 0.75rem;">Cédula</th>
          <th scope="col" style="padding: 0.75rem;">Trabajador</th>
          <th scope="col" style="padding: 0.75rem;">Cargo / Depto</th>
          <th scope="col" style="padding: 0.75rem; text-align: right;">Sueldo Base</th>
          <th scope="col" style="padding: 0.75rem; text-align: right;">Asignaciones</th>
          <th scope="col" style="padding: 0.75rem; text-align: right;">Deducciones</th>
          <th scope="col" style="padding: 0.75rem; text-align: right;">Neto a Cobrar</th>
          <th scope="col" style="padding: 0.75rem; text-align: center;">Acción</th>
        </tr>
      </thead>
      <tbody>
        {% for r in receipts %}
          <tr style="border-bottom: 1px solid var(--border-color);">
            <td style="padding: 0.75rem; font-family: monospace; font-weight: 600;">{{ r.workerCedula }}</td>
            <td style="padding: 0.75rem; font-weight: 600;">
              <a href="/trabajadores/{{ r.workerId }}" style="color: var(--text-color); text-decoration: none;">
                {{ r.workerFullName }}
              </a>
            </td>
            <td style="padding: 0.75rem; color: var(--text-muted);">
              <div>{{ r.jobTitle }}</div>
              <small>{{ r.departmentName }}</small>
            </td>
            <td style="padding: 0.75rem; text-align: right; font-family: monospace;">
              {{ r.snapshot.baseSalaryMonthly.amount }} Bs
            </td>
            <td style="padding: 0.75rem; text-align: right; font-family: monospace; color: #0284c7;">
              {{ r.snapshot.totals.grossEarnings.amount }} Bs
            </td>
            <td style="padding: 0.75rem; text-align: right; font-family: monospace; color: #b91c1c;">
              -{{ r.snapshot.totals.totalDeductions.amount }} Bs
            </td>
            <td style="padding: 0.75rem; text-align: right; font-family: monospace; font-weight: 700; color: #047857;">
              {{ r.snapshot.totals.netPay.amount }} Bs
            </td>
            <td style="padding: 0.75rem; text-align: center;">
              <a href="/nomina/recibos/{{ r.id }}/pdf" target="_blank"
                style="display: inline-flex; align-items: center; gap: 0.35rem; padding: 0.35rem 0.65rem; background: #f1f5f9; border: 1px solid #cbd5e1; border-radius: 4px; font-size: 0.8rem; font-weight: 600; color: var(--text-color); text-decoration: none;">
                <span>📄</span><span>Recibo PDF</span>
              </a>
            </td>
          </tr>
        {% endfor %}
      </tbody>
    </table>
  </div>
</div>
{% endblock %}
