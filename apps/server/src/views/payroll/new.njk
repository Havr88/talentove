{% extends "layouts/base.njk" %}

{% block content %}
<div style="max-width: 750px; margin: 0 auto;">
  <div style="margin-bottom: 1.5rem;">
    <a href="/nomina" style="color: var(--text-muted); font-size: 0.875rem; display: inline-flex; align-items: center; gap: 0.25rem;">
      &larr; Volver a Lotes de Nómina
    </a>
    <h1 style="font-size: 1.5rem; font-weight: 700; color: var(--text-color); margin-top: 0.5rem;">
      Ejecutar Cálculo de Nómina
    </h1>
    <p style="color: var(--text-muted); font-size: 0.875rem;">
      Genera el desglose automático de asignaciones, primas de antigüedad/educación/hijos, retenciones de ley (IVSS, FAOV, SPF) e inasistencias.
    </p>
  </div>

  <div class="card" style="background: white; border: 1px solid var(--border-color); border-radius: var(--radius-lg); padding: 2rem; box-shadow: var(--shadow-sm);">
    <form action="/nomina/procesar" method="POST">
      {% if csrfToken %}<input type="hidden" name="_csrf" value="{{ csrfToken }}">{% endif %}

      <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 1.25rem; margin-bottom: 1.25rem;">
        <div>
          <label style="display: block; font-size: 0.875rem; font-weight: 600; margin-bottom: 0.35rem; color: var(--text-color);">
            Fecha Inicio del Período *
          </label>
          <input type="date" name="periodStart" required value="{{ defaultStart | default('2026-09-01') }}"
            style="width: 100%; padding: 0.6rem 0.75rem; border: 1px solid var(--border-color); border-radius: var(--radius-md); font-size: 0.9rem;">
        </div>
        <div>
          <label style="display: block; font-size: 0.875rem; font-weight: 600; margin-bottom: 0.35rem; color: var(--text-color);">
            Fecha Fin del Período *
          </label>
          <input type="date" name="periodEnd" required value="{{ defaultEnd | default('2026-09-15') }}"
            style="width: 100%; padding: 0.6rem 0.75rem; border: 1px solid var(--border-color); border-radius: var(--radius-md); font-size: 0.9rem;">
        </div>
      </div>

      <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 1.25rem; margin-bottom: 1.25rem;">
        <div>
          <label style="display: block; font-size: 0.875rem; font-weight: 600; margin-bottom: 0.35rem; color: var(--text-color);">
            Frecuencia de Pago *
          </label>
          <select name="periodType" required
            style="width: 100%; padding: 0.6rem 0.75rem; border: 1px solid var(--border-color); border-radius: var(--radius-md); font-size: 0.9rem; background: white;">
            <option value="FORTNIGHT" selected>Quincenal (15 días)</option>
            <option value="MONTHLY">Mensual (30 días)</option>
          </select>
        </div>
        <div>
          <label style="display: block; font-size: 0.875rem; font-weight: 600; margin-bottom: 0.35rem; color: var(--text-color);">
            Salario Mínimo Nacional (VES) *
          </label>
          <input type="text" name="minimumWageVES" value="130.00" required
            style="width: 100%; padding: 0.6rem 0.75rem; border: 1px solid var(--border-color); border-radius: var(--radius-md); font-size: 0.9rem; font-family: monospace;">
          <small style="color: var(--text-muted); font-size: 0.75rem; display: block; margin-top: 0.25rem;">
            Base para los topes legales de 5 salarios mínimos de IVSS y SPF.
          </small>
        </div>
      </div>

      <div style="background: #f8fafc; border: 1px solid var(--border-color); border-radius: var(--radius-md); padding: 1rem; margin-bottom: 1.5rem; font-size: 0.85rem; color: var(--text-muted);">
        <strong style="color: var(--text-color); display: block; margin-bottom: 0.25rem;">Reglas automáticas aplicadas en este proceso:</strong>
        <ul style="margin-left: 1.25rem; line-height: 1.5;">
          <li>Matrices de primas de antigüedad (1% a 30%) y educación (hasta 40%) importadas de APN/sgrhth.</li>
          <li>Primas por hijos de Bs. 12.50 por hijo menor o con discapacidad.</li>
          <li>Deducciones de ley: IVSS (4%), FAOV (1%), SPF (0.5%) y aportes patronales obligatorios.</li>
          <li>Deducción proporcional por inasistencias no justificadas de las planillas de asistencia (Hito M3).</li>
        </ul>
      </div>

      <div style="display: flex; justify-content: flex-end; gap: 0.75rem;">
        <a href="/nomina" class="btn" style="padding: 0.6rem 1.25rem; border: 1px solid var(--border-color); border-radius: var(--radius-md); color: var(--text-color); text-decoration: none;">
          Cancelar
        </a>
        <button type="submit" class="btn btn-primary" style="background: var(--primary-color); color: white; border: none; padding: 0.6rem 1.5rem; border-radius: var(--radius-md); font-weight: 600; cursor: pointer;">
          Calcular y Generar Nómina
        </button>
      </div>
    </form>
  </div>
</div>
{% endblock %}
