{% extends "layouts/base.njk" %}

{% block content %}
<div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 1.5rem;">
  <div>
    <h1 style="font-size: 1.5rem; font-weight: 700; color: var(--text-color);">Nómina LOTTT & APN</h1>
    <p style="color: var(--text-muted); font-size: 0.875rem;">Gestión de pagos quincenales/mensuales, primas de antigüedad, educación, hijos y retenciones de ley.</p>
  </div>
  <a href="/nomina/nueva" class="btn btn-primary" style="display: inline-flex; align-items: center; gap: 0.5rem; background: var(--primary-color); color: white; padding: 0.5rem 1rem; border-radius: var(--radius-md); font-weight: 600;">
    <span>⚡</span><span>Procesar Nueva Nómina</span>
  </a>
</div>

{% if message %}
  <div class="alert alert-success" style="margin-bottom: 1rem; padding: 0.75rem 1rem; background: #ecfdf5; color: #065f46; border: 1px solid #a7f3d0; border-radius: var(--radius-md);">
    {{ message }}
  </div>
{% endif %}

<div class="card" style="background: white; border: 1px solid var(--border-color); border-radius: var(--radius-lg); padding: 1.5rem; box-shadow: var(--shadow-sm);">
  <h2 style="font-size: 1.1rem; font-weight: 600; margin-bottom: 1rem; color: var(--text-color);">Historial de Lotes Procesados</h2>
  
  {% if batches.length === 0 %}
    <div style="text-align: center; padding: 3rem 1rem; color: var(--text-muted);">
      <div style="font-size: 2.5rem; margin-bottom: 0.5rem;">💵</div>
      <p style="font-weight: 500;">No hay nóminas procesadas aún.</p>
      <p style="font-size: 0.85rem; margin-top: 0.25rem;">Haga clic en "Procesar Nueva Nómina" para calcular el período quincenal o mensual según el marco de la LOTTT y APN.</p>
    </div>
  {% else %}
    <div style="overflow-x: auto;">
      <table style="width: 100%; border-collapse: collapse; font-size: 0.875rem; text-align: left;">
        <thead>
          <tr style="border-bottom: 2px solid var(--border-color); color: var(--text-muted);">
            <th scope="col" style="padding: 0.75rem;">Período</th>
            <th scope="col" style="padding: 0.75rem;">Frecuencia</th>
            <th scope="col" style="padding: 0.75rem;">Trabajadores</th>
            <th scope="col" style="padding: 0.75rem; text-align: right;">Total Asignaciones</th>
            <th scope="col" style="padding: 0.75rem; text-align: right;">Total Deducciones</th>
            <th scope="col" style="padding: 0.75rem; text-align: right;">Neto a Pagar</th>
            <th scope="col" style="padding: 0.75rem; text-align: center;">Estado</th>
            <th scope="col" style="padding: 0.75rem; text-align: right;">Acciones</th>
          </tr>
        </thead>
        <tbody>
          {% for b in batches %}
            <tr style="border-bottom: 1px solid var(--border-color);">
              <td style="padding: 0.75rem; font-weight: 600; color: var(--text-color);">
                {{ b.periodStart }} &rarr; {{ b.periodEnd }}
              </td>
              <td style="padding: 0.75rem;">
                <span class="badge" style="padding: 0.2rem 0.5rem; border-radius: 4px; font-size: 0.75rem; background: #e0f2fe; color: #0369a1; font-weight: 600;">
                  {{ "Quincenal" if b.periodType == "FORTNIGHT" else "Mensual" }}
                </span>
              </td>
              <td style="padding: 0.75rem;">{{ b.totalWorkers }} trabajadores</td>
              <td style="padding: 0.75rem; text-align: right; font-family: monospace;">{{ b.totalGross }} Bs</td>
              <td style="padding: 0.75rem; text-align: right; font-family: monospace; color: #b91c1c;">-{{ b.totalDeductions }} Bs</td>
              <td style="padding: 0.75rem; text-align: right; font-family: monospace; font-weight: 700; color: #047857;">{{ b.totalNet }} Bs</td>
              <td style="padding: 0.75rem; text-align: center;">
                <span class="badge" style="padding: 0.2rem 0.5rem; border-radius: 4px; font-size: 0.75rem; background: #dcfce7; color: #15803d; font-weight: 600;">
                  {{ b.status }}
                </span>
              </td>
              <td style="padding: 0.75rem; text-align: right;">
                <a href="/nomina/{{ b.id }}" style="font-weight: 600; color: var(--primary-light); text-decoration: underline;">
                  Ver Recibos &rarr;
                </a>
              </td>
            </tr>
          {% endfor %}
        </tbody>
      </table>
    </div>
  {% endif %}
</div>
{% endblock %}
