<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Verificación de Credencial Laboral | {{ instanceName | default("TalentoVe") }}</title>
  <style>
    :root {
      --primary: #1e3a8a;
      --bg: #f8fafc;
      --text: #0f172a;
      --muted: #64748b;
      --success: #16a34a;
      --danger: #dc2626;
      --card-bg: #ffffff;
      --border: #e2e8f0;
    }
    * { box-sizing: border-box; margin: 0; padding: 0; }
    body {
      font-family: system-ui, -apple-system, sans-serif;
      background: var(--bg);
      color: var(--text);
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      min-height: 100vh;
      padding: 1rem;
    }
    .verify-box {
      width: 100%;
      max-width: 480px;
      background: var(--card-bg);
      border-radius: 16px;
      border: 1px solid var(--border);
      box-shadow: 0 10px 25px -5px rgba(0,0,0,0.08);
      overflow: hidden;
    }
    .banner {
      height: 6px;
      display: flex;
    }
    .b-yellow { flex: 1; background: #facc15; }
    .b-blue { flex: 1; background: #1d4ed8; }
    .b-red { flex: 1; background: #dc2626; }
    .header {
      padding: 1.5rem 1.5rem 1rem;
      text-align: center;
      border-bottom: 1px solid var(--border);
    }
    .header h2 { font-size: 1rem; text-transform: uppercase; color: var(--primary); letter-spacing: 0.5px; }
    .header p { font-size: 0.8rem; color: var(--muted); margin-top: 0.25rem; }

    .status-badge-container {
      padding: 1.5rem;
      text-align: center;
    }
    .badge {
      display: inline-flex;
      align-items: center;
      gap: 0.5rem;
      padding: 0.6rem 1.25rem;
      border-radius: 9999px;
      font-size: 0.95rem;
      font-weight: 700;
    }
    .badge-valid { background: #dcfce7; color: #166534; border: 1px solid #bbf7d0; }
    .badge-invalid { background: #fee2e2; color: #991b1b; border: 1px solid #fecaca; }

    .details {
      padding: 0 1.5rem 1.5rem;
    }
    .detail-row {
      display: flex;
      justify-content: space-between;
      padding: 0.6rem 0;
      border-bottom: 1px solid #f1f5f9;
      font-size: 0.875rem;
    }
    .detail-label { color: var(--muted); font-weight: 500; }
    .detail-value { font-weight: 600; text-align: right; color: var(--text); }

    .footer {
      background: #f8fafc;
      padding: 1rem;
      text-align: center;
      font-size: 0.75rem;
      color: var(--muted);
      border-top: 1px solid var(--border);
    }
  </style>
</head>
<body>
  <div class="verify-box">
    <div class="banner">
      <div class="b-yellow"></div>
      <div class="b-blue"></div>
      <div class="b-red"></div>
    </div>
    <div class="header">
      <h2>República Bolivariana de Venezuela</h2>
      <p>Sistema Oficial de Validación de Identidad Laboral</p>
    </div>

    <div class="status-badge-container">
      {% if valid %}
        <div class="badge badge-valid">
          <span>✓</span><span>CREDENCIAL LABORAL VIGENTE</span>
        </div>
      {% else %}
        <div class="badge badge-invalid">
          <span>⚠️</span><span>CREDENCIAL NO VÁLIDA O REVOCADA</span>
        </div>
        <p style="font-size: 0.85rem; color: #dc2626; margin-top: 0.75rem; font-weight: 500;">
          {{ reason | default("El código de verificación no corresponde a una credencial autorizada.") }}
        </p>
      {% endif %}
    </div>

    {% if valid and worker %}
      <div class="details">
        <div class="detail-row">
          <span class="detail-label">Trabajador:</span>
          <span class="detail-value">{{ worker.firstName }} {{ worker.lastName }}</span>
        </div>
        <div class="detail-row">
          <span class="detail-label">Cédula de Identidad:</span>
          <span class="detail-value" style="font-family: monospace;">{{ worker.cedula }}</span>
        </div>
        <div class="detail-row">
          <span class="detail-label">Cargo Institucional:</span>
          <span class="detail-value">{{ worker.position }}</span>
        </div>
        <div class="detail-row">
          <span class="detail-label">Departamento / Dependencia:</span>
          <span class="detail-value">{{ worker.departmentId }}</span>
        </div>
        <div class="detail-row">
          <span class="detail-label">Estado Laboral:</span>
          <span class="detail-value" style="color: #16a34a;">ACTIVO</span>
        </div>
        <div class="detail-row">
          <span class="detail-label">Fecha de Ingreso:</span>
          <span class="detail-value">{{ worker.hireDate }}</span>
        </div>
        <div class="detail-row">
          <span class="detail-label">Vigencia hasta:</span>
          <span class="detail-value">{{ credential.expiresAt | truncate(10, true, "") }}</span>
        </div>
      </div>
    {% endif %}

    <div class="footer">
      Validación criptográfica en tiempo real &bull; {{ instanceName | default("TalentoVe") }}
    </div>
  </div>
</body>
</html>
