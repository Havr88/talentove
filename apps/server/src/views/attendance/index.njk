{% extends "layouts/base.njk" %}

{% block content %}
<div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 1.5rem;">
  <div>
    <h2 style="margin: 0; color: var(--primary-color);">⏱️ Control y Registro de Asistencia Semanal</h2>
    <p style="color: var(--text-muted); margin-top: 0.25rem;">
      Planillas semanales por departamento conforme a la LOTTT (Arts. 117, 118, 173).
    </p>
  </div>
  {% if currentUser.role in ["superadmin", "admin", "rrhh"] %}
    <a href="/asistencia/nueva" class="btn">+ Nueva Planilla Semanal</a>
  {% endif %}
</div>

{% if query.success %}
  <div class="alert-success">Operación realizada con éxito.</div>
{% endif %}

<div class="card">
  <div style="display: flex; gap: 1rem; margin-bottom: 1.25rem; flex-wrap: wrap;">
    <form method="GET" action="/asistencia" style="display: flex; gap: 0.75rem; flex-grow: 1; align-items: center;">
      <select name="departmentId" class="form-control" style="width: auto; min-width: 220px;" onchange="this.form.submit()">
        <option value="">-- Todos los departamentos --</option>
        {% for dept in departments %}
          <option value="{{ dept.id }}" {% if query.departmentId == dept.id %}selected{% endif %}>{{ dept.name }}</option>
        {% endfor %}
      </select>
      <select name="status" class="form-control" style="width: auto; min-width: 160px;" onchange="this.form.submit()">
        <option value="">-- Todos los estados --</option>
        <option value="borrador" {% if query.status == "borrador" %}selected{% endif %}>Borrador</option>
        <option value="cargada" {% if query.status == "cargada" %}selected{% endif %}>Cargada</option>
        <option value="verificada" {% if query.status == "verificada" %}selected{% endif %}>Verificada</option>
        <option value="cerrada" {% if query.status == "cerrada" %}selected{% endif %}>Cerrada</option>
      </select>
      <noscript><button type="submit" class="btn">Filtrar</button></noscript>
    </form>
  </div>

  {% if sheets.length === 0 %}
    <p style="text-align: center; color: var(--text-muted); padding: 2rem;">
      No se encontraron planillas de asistencia registradas para los criterios seleccionados.
    </p>
  {% else %}
    <div style="overflow-x: auto;">
      <table style="width: 100%; border-collapse: collapse; text-align: left; font-size: 0.95rem;">
        <thead>
          <tr style="border-bottom: 2px solid var(--border-color); background: #fafafa;">
            <th style="padding: 0.75rem;">Semana / Período</th>
            <th style="padding: 0.75rem;">Departamento</th>
            <th style="padding: 0.75rem;">Coordinador</th>
            <th style="padding: 0.75rem;">Verificador RRHH</th>
            <th style="padding: 0.75rem;">Estatus</th>
            <th style="padding: 0.75rem; text-align: right;">Acciones</th>
          </tr>
        </thead>
        <tbody>
          {% for s in sheets %}
            <tr style="border-bottom: 1px solid var(--border-color);">
              <td style="padding: 0.75rem; font-weight: 600;">
                Semana {{ s.weekNumber }} ({{ s.year }})<br>
                <small style="color: var(--text-muted); font-weight: normal;">{{ s.startDate }} al {{ s.endDate }}</small>
              </td>
              <td style="padding: 0.75rem;">{{ s.departmentName | default("Sin asignar") }}</td>
              <td style="padding: 0.75rem;">{{ s.coordinatorName | default("Pendiente") }}</td>
              <td style="padding: 0.75rem;">{{ s.verifiedByName | default("Pendiente") }}</td>
              <td style="padding: 0.75rem;">
                {% if s.status == "verificada" or s.status == "cerrada" %}
                  <span style="background: #e8f5e9; color: #2e7d32; padding: 0.2rem 0.5rem; border-radius: 4px; font-size: 0.8rem; font-weight: 600;">{{ s.status | upper }}</span>
                {% elif s.status == "cargada" %}
                  <span style="background: #e3f2fd; color: #1565c0; padding: 0.2rem 0.5rem; border-radius: 4px; font-size: 0.8rem; font-weight: 600;">CARGADA</span>
                {% else %}
                  <span style="background: #fff3e0; color: #ef6c00; padding: 0.2rem 0.5rem; border-radius: 4px; font-size: 0.8rem; font-weight: 600;">BORRADOR</span>
                {% endif %}
              </td>
              <td style="padding: 0.75rem; text-align: right; white-space: nowrap;">
                <a href="/asistencia/{{ s.id }}" class="btn" style="padding: 0.35rem 0.7rem; font-size: 0.85rem;">Gestionar</a>
                <a href="/asistencia/{{ s.id }}/pdf" class="btn btn-accent" target="_blank" style="padding: 0.35rem 0.7rem; font-size: 0.85rem;">PDF</a>
              </td>
            </tr>
          {% endfor %}
        </tbody>
      </table>
    </div>
  {% endif %}
</div>
{% endblock %}
