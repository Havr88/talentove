{% extends "layouts/base.njk" %}

{% block content %}
<div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 2rem; flex-wrap: wrap; gap: 1rem;">
  <div>
    <h1 style="font-size: 1.85rem; font-weight: 800; color: var(--text-color); letter-spacing: -0.02em; margin: 0;">
      ⏱️ Control y Registro de Asistencia Semanal
    </h1>
    <p style="color: var(--text-muted); font-size: 0.95rem; margin-top: 0.25rem;">
      Planillas departamentales, cómputo de horas extras y bono nocturno conforme a la LOTTT.
    </p>
  </div>
  {% if currentUser.role in ["superadmin", "admin", "rrhh"] %}
    <a href="/asistencia/nueva" class="btn btn-primary">
      <span>➕</span> Nueva Planilla Semanal
    </a>
  {% endif %}
</div>

{% if query.success %}
  <div class="alert-success">
    <span>✓</span>
    <span>Operación de asistencia realizada con éxito.</span>
  </div>
{% endif %}

<div class="table-container">
  <div style="padding: 1.25rem 1.5rem; background: var(--card-bg); border-bottom: 1px solid var(--border-color); display: flex; gap: 1rem; flex-wrap: wrap; align-items: center;">
    <form method="GET" action="/asistencia" style="display: flex; gap: 0.75rem; flex-grow: 1; align-items: center; flex-wrap: wrap;">
      <select name="departmentId" class="form-control" style="width: auto; min-width: 240px;" onchange="this.form.submit()">
        <option value="">-- Todos los departamentos --</option>
        {% for dept in departments %}
          <option value="{{ dept.id }}" {% if query.departmentId == dept.id %}selected{% endif %}>{{ dept.name }}</option>
        {% endfor %}
      </select>
      <select name="status" class="form-control" style="width: auto; min-width: 180px;" onchange="this.form.submit()">
        <option value="">-- Todos los estatus --</option>
        <option value="borrador" {% if query.status == "borrador" %}selected{% endif %}>Borrador</option>
        <option value="cargada" {% if query.status == "cargada" %}selected{% endif %}>Cargada</option>
        <option value="verificada" {% if query.status == "verificada" %}selected{% endif %}>Verificada</option>
        <option value="cerrada" {% if query.status == "cerrada" %}selected{% endif %}>Cerrada</option>
      </select>
      {% if query.departmentId or query.status %}
        <a href="/asistencia" class="btn btn-outline btn-sm">Limpiar Filtros</a>
      {% endif %}
    </form>
  </div>

  {% if sheets.length === 0 %}
    <p style="text-align: center; color: var(--text-muted); padding: 3.5rem;">
      No se encontraron planillas de asistencia registradas para los criterios seleccionados.
    </p>
  {% else %}
    <table class="data-table">
      <thead>
        <tr>
          <th>Semana / Período</th>
          <th>Departamento</th>
          <th>Coordinador</th>
          <th>Verificador RRHH</th>
          <th style="width: 140px; text-align: center;">Estatus</th>
          <th style="text-align: right; width: 170px;">Acciones</th>
        </tr>
      </thead>
      <tbody>
        {% for s in sheets %}
          <tr>
            <td style="font-weight: 700; color: var(--primary-color);">
              Semana {{ s.weekNumber }} &bull; {{ s.year }}<br>
              <small style="color: var(--text-muted); font-weight: normal;">{{ s.startDate }} al {{ s.endDate }}</small>
            </td>
            <td>
              <span style="font-weight: 600;">{{ s.departmentName | default("Sin asignar") }}</span>
            </td>
            <td style="color: var(--text-muted);">
              {{ s.coordinatorName | default("Pendiente") }}
            </td>
            <td style="color: var(--text-muted);">
              {{ s.verifiedByName | default("Pendiente") }}
            </td>
            <td style="text-align: center;">
              {% if s.status == "verificada" or s.status == "cerrada" %}
                <span class="badge badge-success"><span class="badge-dot"></span> {{ s.status | upper }}</span>
              {% elif s.status == "cargada" %}
                <span class="badge badge-info"><span class="badge-dot"></span> CARGADA</span>
              {% else %}
                <span class="badge badge-warning"><span class="badge-dot"></span> BORRADOR</span>
              {% endif %}
            </td>
            <td style="text-align: right; white-space: nowrap;">
              <a href="/asistencia/{{ s.id }}" class="btn btn-outline btn-sm" style="font-weight: 600;">Gestionar</a>
              <a href="/asistencia/{{ s.id }}/pdf" class="btn btn-accent btn-sm" target="_blank">PDF</a>
            </td>
          </tr>
        {% endfor %}
      </tbody>
    </table>
  {% endif %}
</div>
{% endblock %}
