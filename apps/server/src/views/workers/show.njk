{% extends "layouts/base.njk" %}

{% block content %}
<div style="margin-bottom: 1.5rem;">
  <div style="margin-bottom: 0.5rem;">
    <a href="/trabajadores" style="color: var(--text-muted); text-decoration: none; font-size: 0.875rem;">&larr; Volver al Listado</a>
  </div>
  <div style="display: flex; justify-content: space-between; align-items: flex-start; flex-wrap: wrap; gap: 1rem;">
    <div>
      <div style="display: flex; align-items: center; gap: 0.75rem; flex-wrap: wrap;">
        <h1 style="font-size: 1.85rem; font-weight: 800; color: var(--text-color); letter-spacing: -0.02em; margin: 0;">
          {{ employee.nombres }} {{ employee.apellidos }}
        </h1>
        {% if employee.status == 'activo' %}
          <span class="badge badge-success"><span class="badge-dot"></span> ACTIVO</span>
        {% else %}
          <span class="badge badge-neutral"><span class="badge-dot"></span> {{ employee.status | upper }}</span>
        {% endif %}
      </div>
      <p style="color: var(--text-muted); font-size: 0.95rem; margin-top: 0.35rem;">
        Cédula: <strong style="color: var(--primary-color);">{{ employee.cedulaTipo }}-{{ employee.cedulaNumero }}</strong>
        {% if employee.rif %} &bull; RIF: <strong>{{ employee.rif }}</strong>{% endif %}
      </p>
    </div>
    <div style="display: flex; gap: 0.6rem; flex-wrap: wrap;">
      <a href="/trabajadores/{{ employee.id }}/editar" class="btn btn-outline">✏️ Editar Datos</a>
      <a href="/trabajadores/{{ employee.id }}/carnet" class="btn btn-outline" style="border-color: #3b82f6; color: #1d4ed8;">🪪 Carnet CR-80</a>
      <a href="/trabajadores/{{ employee.id }}/constancia/pdf" target="_blank" class="btn btn-accent">📄 Constancia PDF</a>
      <a href="/trabajadores/{{ employee.id }}/riesgos-lopcymat" class="btn btn-outline" style="border-color: #0284c7; color: #0369a1;">🛡️ LOPCYMAT</a>
      <a href="/trabajadores/{{ employee.id }}/activos" class="btn btn-outline" style="border-color: #10b981; color: #047857;">📦 Activos</a>
      <a href="/trabajadores/{{ employee.id }}/liquidacion" class="btn btn-outline" style="border-color: #ef4444; color: #b91c1c;">⚖️ Liquidación</a>
      <a href="/solicitudes/nueva?employeeId={{ employee.id }}" class="btn btn-primary">📝 Solicitud</a>
    </div>
  </div>
</div>

{% if success %}
  <div class="alert-success">{{ success }}</div>
{% endif %}
{% if error %}
  <div class="alert-error">{{ error }}</div>
{% endif %}

<!-- Grid de Información Principal -->
<div style="display: grid; grid-template-columns: 1fr 1fr; gap: 1.5rem; margin-bottom: 1.5rem;">
  <!-- Ficha Personal -->
  <div class="card">
    <h3 style="font-size: 1.1rem; color: var(--primary-color); margin-bottom: 1rem; border-bottom: 2px solid var(--border-color); padding-bottom: 0.5rem;">
      👤 Datos Personales y de Contacto
    </h3>
    <table style="width: 100%; border-collapse: collapse; font-size: 0.9rem;">
      <tr>
        <td style="padding: 0.4rem 0; color: var(--text-muted); width: 40%;">Grado de Instrucción:</td>
        <td style="padding: 0.4rem 0; font-weight: 500;">{{ employee.gradoInstruccion | default('—', true) }}</td>
      </tr>
      <tr>
        <td style="padding: 0.4rem 0; color: var(--text-muted); width: 40%;">Fecha de Nacimiento:</td>
        <td style="padding: 0.4rem 0; font-weight: 500;">{{ employee.fechaNacimiento }}</td>
      </tr>
      <tr>
        <td style="padding: 0.4rem 0; color: var(--text-muted);">Sexo:</td>
        <td style="padding: 0.4rem 0; font-weight: 500;">{% if employee.sexo == 'M' %}Masculino{% else %}Femenino{% endif %}</td>
      </tr>
      <tr>
        <td style="padding: 0.4rem 0; color: var(--text-muted);">Estado Civil:</td>
        <td style="padding: 0.4rem 0; font-weight: 500; text-transform: capitalize;">{{ employee.estadoCivil }}</td>
      </tr>
      <tr>
        <td style="padding: 0.4rem 0; color: var(--text-muted);">Correo Electrónico:</td>
        <td style="padding: 0.4rem 0; font-weight: 500;">{{ employee.correo or 'No registrado' }}</td>
      </tr>
      <tr>
        <td style="padding: 0.4rem 0; color: var(--text-muted);">Teléfono:</td>
        <td style="padding: 0.4rem 0; font-weight: 500;">{{ employee.telefono or 'No registrado' }}</td>
      </tr>
      <tr>
        <td style="padding: 0.4rem 0; color: var(--text-muted);">Dirección de Habitación:</td>
        <td style="padding: 0.4rem 0; font-weight: 500;">{{ employee.direccion }}</td>
      </tr>
      <tr>
        <td style="padding: 0.4rem 0; color: var(--text-muted);">Entidad Federal (Estado):</td>
        <td style="padding: 0.4rem 0; font-weight: 500;">{{ territory.nombre if territory else 'Distrito Capital' }}</td>
      </tr>
    </table>
  </div>

  <!-- Ficha Laboral Activa -->
  <div class="card">
    <h3 style="font-size: 1.1rem; color: var(--primary-color); margin-bottom: 1rem; border-bottom: 2px solid var(--border-color); padding-bottom: 0.5rem;">
      💼 Relación Contractual Activa
    </h3>
    {% if activeContract %}
      <div class="table-scroll">
      <table style="width: 100%; border-collapse: collapse; font-size: 0.9rem;">
        <tr>
          <td style="padding: 0.4rem 0; color: var(--text-muted); width: 40%;">Cargo:</td>
          <td style="padding: 0.4rem 0; font-weight: 600; color: var(--primary-color);">{{ position.name if position else 'Cargo General' }}</td>
        </tr>
        <tr>
          <td style="padding: 0.4rem 0; color: var(--text-muted);">Unidad Adscrita:</td>
          <td style="padding: 0.4rem 0; font-weight: 500;">{{ orgUnit.name if orgUnit else 'Sede Central' }}</td>
        </tr>
        <tr>
          <td style="padding: 0.4rem 0; color: var(--text-muted);">Sector:</td>
          <td style="padding: 0.4rem 0; font-weight: 500; text-transform: uppercase;">
            <span style="display: inline-block; padding: 0.15rem 0.5rem; border-radius: 4px; font-size: 0.75rem; background: #e3f2fd; color: #1565c0;">
              {{ activeContract.sector }}
            </span>
          </td>
        </tr>
        <tr>
          <td style="padding: 0.4rem 0; color: var(--text-muted);">Tipo de Contrato:</td>
          <td style="padding: 0.4rem 0; font-weight: 500; text-transform: capitalize;">{{ activeContract.tipo }}</td>
        </tr>
        <tr>
          <td style="padding: 0.4rem 0; color: var(--text-muted);">Fecha de Ingreso:</td>
          <td style="padding: 0.4rem 0; font-weight: 500;">{{ activeContract.fechaIngreso }}</td>
        </tr>
        <tr>
          <td style="padding: 0.4rem 0; color: var(--text-muted);">Salario Base:</td>
          <td style="padding: 0.4rem 0; font-weight: 700; font-size: 1rem; color: #2e7d32;">
            {{ activeContract.currency }} {{ activeContract.salarioBase }}
          </td>
        </tr>
      </table>
      </div>
    {% else %}
      <p style="color: var(--text-muted); font-size: 0.9rem;">No tiene contrato activo actualmente.</p>
    {% endif %}
  </div>
</div>

<!-- Sección de Documentos Probatorios del Expediente -->
<div class="card" style="margin-bottom: 1.5rem;">
  <h3 style="font-size: 1.1rem; color: var(--primary-color);">🎓 Documentos Probatorios del Expediente</h3>
  <p style="color: var(--text-muted); font-size: 0.82rem; margin: 0.25rem 0 0.9rem;">
    Los requisitos obligatorios se calculan según el grado de instrucción y la normativa (LOPCYMAT).
    Títulos y certificados en JPG o PDF con sus metadatos.
  </p>

  {% set secciones = [] %}
  {% for t in docTypes %}{% if t.seccion not in secciones %}{% set secciones = secciones.concat([t.seccion]) %}{% endif %}{% endfor %}

  {% for seccion_actual in secciones %}
    <h4 style="font-size: 0.92rem; margin: 1rem 0 0.4rem; color: var(--primary-dark);">{{ seccion_actual }}</h4>
    <div class="table-scroll">
    <table style="width: 100%; border-collapse: collapse; font-size: 0.85rem;">
      <thead>
        <tr style="background: #fafafa; border-bottom: 1px solid var(--border-color); text-align: left;">
          <th scope="col" style="padding: 0.45rem 0.75rem;">Documento</th>
          <th scope="col" style="padding: 0.45rem 0.75rem;">Obligatoriedad</th>
          <th scope="col" style="padding: 0.45rem 0.75rem;">Estado / Metadatos</th>
          <th scope="col" style="padding: 0.45rem 0.75rem; text-align: right;">Adjuntar</th>
        </tr>
      </thead>
      <tbody>
        {% for t in docTypes %}
          {% if t.seccion == seccion_actual %}
          <tr style="border-bottom: 1px solid var(--border-color);">
            <td style="padding: 0.45rem 0.75rem; font-weight: 500;">
              {{ t.nombre }}
              <div style="font-size: 0.72rem; color: var(--text-muted);">{{ t.base_legal }}</div>
            </td>
            <td style="padding: 0.45rem 0.75rem;">
              {% set esRequerido = (t.id in requeridos) or (t.requerido == 'siempre') %}
              {% if esRequerido %}
                <span style="padding: 0.1rem 0.45rem; border-radius: 4px; font-size: 0.72rem; background: #ffebee; color: #c62828;">Obligatorio</span>
              {% else %}
                <span style="padding: 0.1rem 0.45rem; border-radius: 4px; font-size: 0.72rem; background: #e2e8f0; color: #334155;">Opcional</span>
              {% endif %}
            </td>
            <td style="padding: 0.45rem 0.75rem;">
              {% set adjuntos = workerDocs | selectattr('tipoDoc', '==', t.id) | list %}
              {% if adjuntos | length > 0 %}
                {% for doc in adjuntos %}
                  <div style="margin-bottom: 0.2rem;">
                    <a href="/documentos/{{ doc.id }}/ver" target="_blank" style="color: #2e7d32; font-size: 0.8rem; font-weight: 600; text-decoration: none;">✓ {{ doc.fileName }}</a>
                    <span style="color: var(--text-muted); font-size: 0.72rem;"> ({{ doc.size }}, {{ doc.date }})</span>
                    {% if doc.metadataParsed %}
                      <div style="font-size: 0.72rem; color: var(--text-muted); margin-left: 0.9rem;">
                        {% for campo in t.campos %}{% if doc.metadataParsed[campo.key] %}{{ campo.label }}: <b>{{ doc.metadataParsed[campo.key] }}</b> · {% endif %}{% endfor %}
                      </div>
                    {% endif %}
                  </div>
                {% endfor %}
              {% elif esRequerido %}
                <span style="padding: 0.1rem 0.45rem; border-radius: 4px; font-size: 0.72rem; background: #ffedd5; color: #9a3412;">⚠ Falta (obligatorio)</span>
              {% else %}
                <span style="color: var(--text-muted); font-size: 0.75rem;">Sin adjuntar</span>
              {% endif %}
            </td>
            <td style="padding: 0.45rem 0.75rem; text-align: right;">
              <details>
                <summary style="cursor: pointer; font-size: 0.78rem; color: #1565c0;">📎 Adjuntar</summary>
                <form class="form-doc-trabajador" data-worker="{{ employee.id }}" data-tipo="{{ t.id }}" style="margin-top: 0.5rem; text-align: left;">
                  {% for campo in t.campos %}
                    <div style="margin-bottom: 0.3rem;">
                      <label style="font-size: 0.7rem; font-weight: 600; color: var(--text-muted);">{{ campo.label }}</label>
                      {% if campo.tipo == 'fecha' %}
                      <input type="date" name="md_{{ campo.key }}" style="padding: 0.25rem 0.4rem; font-size: 0.78rem; width: 170px;">
                      {% elif campo.tipo == 'numero' %}
                      <input type="number" name="md_{{ campo.key }}" style="padding: 0.25rem 0.4rem; font-size: 0.78rem; width: 170px;">
                      {% else %}
                      <input type="text" name="md_{{ campo.key }}" style="padding: 0.25rem 0.4rem; font-size: 0.78rem; width: 170px;">
                      {% endif %}
                    </div>
                  {% endfor %}
                  <input type="file" accept=".jpg,.jpeg,.pdf" required style="font-size: 0.78rem; max-width: 200px;">
                  <button type="submit" class="btn" style="padding: 0.25rem 0.6rem; font-size: 0.78rem;">Subir</button>
                  <span class="doc-status" role="status" aria-live="polite" style="font-size: 0.75rem; color: var(--text-muted);"></span>
                </form>
              </details>
            </td>
          </tr>
          {% endif %}
        {% endfor %}
      </tbody>
    </table>
    </div>
  {% endfor %}

  <script>
    document.querySelectorAll('.form-doc-trabajador').forEach(function (form) {
      form.addEventListener('submit', async function (ev) {
        ev.preventDefault();
        var fileInput = form.querySelector('input[type=file]');
        var status = form.querySelector('.doc-status');
        var file = fileInput.files[0];
        if (!file) { status.textContent = 'Seleccione un archivo'; return; }
        if (!['image/jpeg', 'application/pdf'].includes(file.type)) { status.textContent = 'Solo JPG o PDF'; return; }
        if (file.size > 5 * 1024 * 1024) { status.textContent = 'Máximo 5 MB'; return; }
        status.textContent = 'Subiendo…';
        form.querySelector('button[type=submit]').disabled = true;
        var dataBase64 = await new Promise(function (ok) {
          var fr = new FileReader();
          fr.onload = function () { ok(String(fr.result).split(',')[1]); };
          fr.readAsDataURL(file);
        });
        var metadata = {};
        form.querySelectorAll('[name^=md_]').forEach(function (inp) {
          if (inp.value && inp.value.trim() !== '') metadata[inp.name.slice(3)] = inp.value.trim();
        });
        try {
          var r = await fetch('/api/trabajadores/' + form.dataset.worker + '/documentos', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json', 'x-csrf-token': '{{ csrfToken }}' },
            body: JSON.stringify({ fileName: file.name, mimeType: file.type, dataBase64: dataBase64, tipoDoc: form.dataset.tipo, metadata: metadata }),
          });
          var body = await r.json();
          if (!r.ok || !body.success) { status.textContent = body.error || 'Error al subir'; form.querySelector('button[type=submit]').disabled = false; return; }
          status.textContent = '✓ Subido — recargando…';
          setTimeout(function () { window.location.reload(); }, 700);
        } catch (e) { status.textContent = 'Error de red'; }
      });
    });
  </script>
</div>

<!-- Sección de Cargas Familiares -->
<div class="card" style="margin-bottom: 1.5rem;">
  <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 1rem;">
    <h3 style="font-size: 1.1rem; color: var(--primary-color);">👨‍👩‍👧‍👦 Cargas Familiares y Dependientes (IVSS / Nómina)</h3>
    <button onclick="document.getElementById('form-carga').style.display = document.getElementById('form-carga').style.display === 'none' ? 'block' : 'none';" class="btn" style="padding: 0.35rem 0.85rem; font-size: 0.85rem;">
      ➕ Añadir Dependiente
    </button>
  </div>

  <!-- Formulario desplegable para agregar dependiente -->
  <div id="form-carga" style="display: none; background: #f5f7fa; padding: 1.25rem; border-radius: 6px; margin-bottom: 1rem; border: 1px solid var(--border-color);">
    <h4 style="font-size: 0.95rem; margin-bottom: 0.75rem; color: var(--primary-color);">Registrar Nueva Carga Familiar</h4>
    <form action="/trabajadores/{{ employee.id }}/cargas" method="POST" class="form-guard" style="display: grid; grid-template-columns: repeat(3, 1fr); gap: 0.75rem;">
      <input type="hidden" name="_csrf" value="{{ csrfToken }}">
      <div>
        <label style="font-size: 0.8rem; font-weight: 600;">Nombres *</label>
        <input type="text" name="nombres" class="form-control" required style="padding: 0.35rem 0.5rem; font-size: 0.85rem;">
      </div>
      <div>
        <label style="font-size: 0.8rem; font-weight: 600;">Apellidos *</label>
        <input type="text" name="apellidos" class="form-control" required style="padding: 0.35rem 0.5rem; font-size: 0.85rem;">
      </div>
      <div>
        <label style="font-size: 0.8rem; font-weight: 600;">Parentesco *</label>
        <select name="parentesco" class="form-control" required style="padding: 0.35rem 0.5rem; font-size: 0.85rem;">
          <option value="hijo">Hijo / Hija</option>
          <option value="conyuge">Cónyuge / Pareja</option>
          <option value="padre">Padre</option>
          <option value="madre">Madre</option>
          <option value="otro">Otro</option>
        </select>
      </div>
      <div>
        <label style="font-size: 0.8rem; font-weight: 600;">Cédula (si aplica)</label>
        <input type="text" name="cedula" class="form-control" placeholder="V-12345678" style="padding: 0.35rem 0.5rem; font-size: 0.85rem;">
      </div>
      <div>
        <label style="font-size: 0.8rem; font-weight: 600;">Fecha de Nacimiento *</label>
        <input type="date" name="fechaNacimiento" class="form-control" required style="padding: 0.35rem 0.5rem; font-size: 0.85rem;">
      </div>
      <div>
        <label style="font-size: 0.8rem; font-weight: 600;">Sexo *</label>
        <select name="sexo" class="form-control" required style="padding: 0.35rem 0.5rem; font-size: 0.85rem;">
          <option value="M">Masculino</option>
          <option value="F">Femenino</option>
        </select>
      </div>
      <div style="grid-column: span 3; display: flex; justify-content: flex-end; gap: 0.5rem; margin-top: 0.5rem;">
        <button type="button" onclick="document.getElementById('form-carga').style.display='none'" class="btn" style="background: #90a4ae; padding: 0.4rem 0.85rem; font-size: 0.85rem;">Cancelar</button>
        <button type="submit" class="btn" style="padding: 0.4rem 0.85rem; font-size: 0.85rem;">Guardar Carga</button>
      </div>
    </form>
  </div>

  <div class="table-scroll">
  <table style="width: 100%; border-collapse: collapse; font-size: 0.9rem;">
    <thead>
      <tr style="background: #fafafa; border-bottom: 1px solid var(--border-color); text-align: left;">
        <th scope="col" style="padding: 0.6rem 1rem;">Nombre Completo</th>
        <th scope="col" style="padding: 0.6rem 1rem;">Parentesco</th>
        <th scope="col" style="padding: 0.6rem 1rem;">Cédula</th>
        <th scope="col" style="padding: 0.6rem 1rem;">Fecha Nacimiento</th>
        <th scope="col" style="padding: 0.6rem 1rem;">Requisitos Documentales (JPG/PDF)</th>
        <th scope="col" style="padding: 0.6rem 1rem; text-align: right;">Acciones</th>
      </tr>
    </thead>
    <tbody>
      {% for dep in dependents %}
        {% set reqDocs = [] %}
        {% if dep.parentesco == 'hijo' %}{% set reqDocs = reqDocs.concat(['Partida de Nacimiento']) %}{% endif %}
        {% if dep.parentesco == 'conyuge' %}{% set reqDocs = reqDocs.concat(['Acta de Matrimonio']) %}{% endif %}
        {% if dep.discapacidad %}{% set reqDocs = reqDocs.concat(['Certificado CONAPDIS']) %}{% endif %}
        <tr style="border-bottom: 1px solid var(--border-color);">
          <td style="padding: 0.6rem 1rem; font-weight: 500;">{{ dep.nombres }} {{ dep.apellidos }}</td>
          <td style="padding: 0.6rem 1rem; text-transform: capitalize;">{{ dep.parentesco }}</td>
          <td style="padding: 0.6rem 1rem;">{{ dep.cedula or 'Menor sin cédula' }}</td>
          <td style="padding: 0.6rem 1rem;">{{ dep.fechaNacimiento }}</td>
          <td style="padding: 0.6rem 1rem;">
            {% if reqDocs | length == 0 %}
              <span style="color: var(--text-muted); font-size: 0.8rem;">Sin documento obligatorio</span>
            {% endif %}
            {% for req in reqDocs %}
              {% set attached = dependentDocs | selectattr('dependentId', '==', dep.id) | selectattr('tipoDoc', '==', req) | list %}
              {% if attached | length > 0 %}
                <span style="display: inline-block; margin: 0.15rem 0.3rem 0.15rem 0; padding: 0.1rem 0.45rem; border-radius: 4px; font-size: 0.75rem; background: #e8f5e9; color: #2e7d32;">✓ {{ req }}</span>
                {% for doc in attached %}
                  <a href="/documentos/{{ doc.id }}/ver" target="_blank" style="font-size: 0.75rem; color: #1565c0; text-decoration: none;">({{ doc.size }})</a>
                {% endfor %}
              {% else %}
                <span style="display: inline-block; margin: 0.15rem 0.3rem 0.15rem 0; padding: 0.1rem 0.45rem; border-radius: 4px; font-size: 0.75rem; background: #ffedd5; color: #9a3412;">⚠ Falta: {{ req }}</span>
              {% endif %}
            {% endfor %}
            <details style="display: inline-block; margin-left: 0.4rem;">
              <summary style="cursor: pointer; font-size: 0.78rem; color: #1565c0;">📎 Adjuntar</summary>
              <form class="form-adjuntar" data-worker="{{ employee.id }}" data-carga="{{ dep.id }}" style="margin-top: 0.5rem;">
                <input type="hidden" name="tipoDoc" value="{{ reqDocs[0] if reqDocs | length > 0 else 'Documento del dependiente' }}">
                <input type="file" accept=".jpg,.jpeg,.pdf" required style="font-size: 0.78rem; max-width: 220px;">
                <button type="submit" class="btn" style="padding: 0.25rem 0.6rem; font-size: 0.78rem;">Subir</button>
                <span class="adj-status" role="status" aria-live="polite" style="font-size: 0.75rem; color: var(--text-muted);"></span>
              </form>
            </details>
          </td>
          <td style="padding: 0.6rem 1rem; text-align: right;">
            <form action="/trabajadores/{{ employee.id }}/cargas/{{ dep.id }}/eliminar" method="POST" style="display: inline;">
              <input type="hidden" name="_csrf" value="{{ csrfToken }}">
              <button type="submit" style="background: none; border: none; color: #c62828; cursor: pointer; font-size: 0.85rem;" onclick="return confirm('¿Desea eliminar esta carga familiar?');">
                ❌ Eliminar
              </button>
            </form>
          </td>
        </tr>
      {% else %}
        <tr>
          <td colspan="6" style="padding: 1.5rem; text-align: center; color: var(--text-muted);">
            No tiene cargas familiares registradas.
          </td>
        </tr>
      {% endfor %}
    </tbody>
  </table>
  </div>

  <script>
    document.querySelectorAll('.form-adjuntar').forEach(function (form) {
      form.addEventListener('submit', async function (ev) {
        ev.preventDefault();
        var fileInput = form.querySelector('input[type=file]');
        var status = form.querySelector('.adj-status');
        var file = fileInput.files[0];
        if (!file) { status.textContent = 'Seleccione un archivo'; return; }
        if (!['image/jpeg', 'application/pdf'].includes(file.type)) { status.textContent = 'Solo JPG o PDF'; return; }
        if (file.size > 5 * 1024 * 1024) { status.textContent = 'Máximo 5 MB'; return; }
        status.textContent = 'Subiendo…';
        form.querySelector('button[type=submit]').disabled = true;
        var dataBase64 = await new Promise(function (ok) {
          var fr = new FileReader();
          fr.onload = function () { ok(String(fr.result).split(',')[1]); };
          fr.readAsDataURL(file);
        });
        try {
          var r = await fetch('/api/trabajadores/' + form.dataset.worker + '/cargas/' + form.dataset.carga + '/documentos', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json', 'x-csrf-token': '{{ csrfToken }}' },
            body: JSON.stringify({ fileName: file.name, mimeType: file.type, dataBase64: dataBase64, tipoDoc: form.querySelector('[name=tipoDoc]').value }),
          });
          var body = await r.json();
          if (!r.ok || !body.success) { status.textContent = body.error || 'Error al subir'; form.querySelector('button[type=submit]').disabled = false; return; }
          status.textContent = '✓ Subido (' + body.data.size + ') — recargando…';
          form.querySelector('button[type=submit]').disabled = false;
          setTimeout(function () { window.location.reload(); }, 700);
        } catch (e) {
          status.textContent = 'Error de red';
        }
      });
    });
  </script>
</div>

<!-- Sección de Historial de Movimientos Contractuales -->
<div class="card" style="margin-bottom: 1.5rem;">
  <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 1rem;">
    <h3 style="font-size: 1.1rem; color: var(--primary-color);">📈 Historial de Movimientos y Ascensos</h3>
    <button onclick="document.getElementById('form-movimiento').style.display = document.getElementById('form-movimiento').style.display === 'none' ? 'block' : 'none';" class="btn" style="background-color: #00695c; padding: 0.35rem 0.85rem; font-size: 0.85rem;">
      ➕ Registrar Movimiento
    </button>
  </div>

  <!-- Formulario de Movimiento Contractual -->
  <div id="form-movimiento" style="display: none; background: #e0f2f1; padding: 1.25rem; border-radius: 6px; margin-bottom: 1rem; border: 1px solid #b2dfdb;">
    <h4 style="font-size: 0.95rem; margin-bottom: 0.75rem; color: #004d40;">Registrar Ascenso, Transferencia o Ajuste Salarial</h4>
    <form action="/trabajadores/{{ employee.id }}/movimientos" method="POST" style="display: grid; grid-template-columns: repeat(3, 1fr); gap: 0.75rem;">
      <input type="hidden" name="_csrf" value="{{ csrfToken }}">
      <div>
        <label style="font-size: 0.8rem; font-weight: 600;">Tipo de Movimiento *</label>
        <select name="tipoMovimiento" class="form-control" required style="padding: 0.35rem 0.5rem; font-size: 0.85rem;">
          <option value="ajuste_salarial">Ajuste Salarial / Aumento</option>
          <option value="ascenso">Ascenso de Cargo</option>
          <option value="transferencia">Transferencia de Unidad</option>
          <option value="suspension">Suspensión Temporal</option>
        </select>
      </div>
      <div>
        <label style="font-size: 0.8rem; font-weight: 600;">Fecha Efectiva *</label>
        <input type="date" name="fechaEfectiva" class="form-control" required style="padding: 0.35rem 0.5rem; font-size: 0.85rem;">
      </div>
      <div>
        <label style="font-size: 0.8rem; font-weight: 600;">Nuevo Salario Base *</label>
        <input type="number" step="0.01" name="salarioNuevo" class="form-control" value="{{ activeContract.salarioBase if activeContract else '0' }}" required style="padding: 0.35rem 0.5rem; font-size: 0.85rem;">
      </div>
      <div>
        <label style="font-size: 0.8rem; font-weight: 600;">Nuevo Cargo *</label>
        <input type="text" name="cargoNuevo" class="form-control" value="{{ position.name if position else '' }}" required style="padding: 0.35rem 0.5rem; font-size: 0.85rem;">
      </div>
      <div>
        <label style="font-size: 0.8rem; font-weight: 600;">Nueva Unidad *</label>
        <input type="text" name="unidadNueva" class="form-control" value="{{ orgUnit.name if orgUnit else '' }}" required style="padding: 0.35rem 0.5rem; font-size: 0.85rem;">
      </div>
      <div>
        <label style="font-size: 0.8rem; font-weight: 600;">Motivo / Justificación</label>
        <input type="text" name="motivo" class="form-control" placeholder="Evaluación de desempeño, ajuste anual..." style="padding: 0.35rem 0.5rem; font-size: 0.85rem;">
      </div>
      <div style="grid-column: span 3; display: flex; justify-content: flex-end; gap: 0.5rem; margin-top: 0.5rem;">
        <button type="button" onclick="document.getElementById('form-movimiento').style.display='none'" class="btn" style="background: #90a4ae; padding: 0.4rem 0.85rem; font-size: 0.85rem;">Cancelar</button>
        <button type="submit" class="btn" style="background: #00695c; padding: 0.4rem 0.85rem; font-size: 0.85rem;">Aplicar Movimiento</button>
      </div>
    </form>
  </div>

  <table style="width: 100%; border-collapse: collapse; font-size: 0.9rem;">
    <thead>
      <tr style="background: #fafafa; border-bottom: 1px solid var(--border-color); text-align: left;">
        <th scope="col" style="padding: 0.6rem 1rem;">Fecha</th>
        <th scope="col" style="padding: 0.6rem 1rem;">Movimiento</th>
        <th scope="col" style="padding: 0.6rem 1rem;">Cargo Nuevo</th>
        <th scope="col" style="padding: 0.6rem 1rem;">Unidad Nueva</th>
        <th scope="col" style="padding: 0.6rem 1rem;">Salario Nuevo</th>
        <th scope="col" style="padding: 0.6rem 1rem;">Motivo</th>
      </tr>
    </thead>
    <tbody>
      {% for mov in movements %}
        <tr style="border-bottom: 1px solid var(--border-color);">
          <td style="padding: 0.6rem 1rem; font-weight: 500;">{{ mov.fechaEfectiva }}</td>
          <td style="padding: 0.6rem 1rem; text-transform: capitalize;">{{ mov.tipoMovimiento }}</td>
          <td style="padding: 0.6rem 1rem;">{{ mov.cargoNuevo }}</td>
          <td style="padding: 0.6rem 1rem;">{{ mov.unidadNueva }}</td>
          <td style="padding: 0.6rem 1rem; font-weight: 600; color: #2e7d32;">{{ mov.salarioNuevo }}</td>
          <td style="padding: 0.6rem 1rem; color: var(--text-muted);">{{ mov.motivo or 'N/A' }}</td>
        </tr>
      {% else %}
        <tr>
          <td colspan="6" style="padding: 1.5rem; text-align: center; color: var(--text-muted);">
            No hay movimientos registrados para este expediente.
          </td>
        </tr>
      {% endfor %}
    </tbody>
  </table>
</div>
{% endblock %}
