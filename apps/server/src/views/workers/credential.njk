{% extends "layouts/base.njk" %}

{% block content %}
<div style="max-width: 900px; margin: 0 auto;">
  <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 1.5rem;" class="no-print">
    <div>
      <a href="/trabajadores/{{ worker.id }}" style="color: var(--text-muted); font-size: 0.875rem; display: inline-flex; align-items: center; gap: 0.25rem;">
        &larr; Volver al Expediente del Trabajador
      </a>
      <h1 style="font-size: 1.5rem; font-weight: 700; color: var(--text-color); margin-top: 0.5rem;">
        Carnet de Identificación Laboral (Formato CR-80)
      </h1>
      <p style="color: var(--text-muted); font-size: 0.875rem;">
        Credencial estándar con código QR de verificación criptográfica en tiempo real.
      </p>
    </div>
    <div style="display: flex; gap: 0.75rem;">
      <button onclick="window.print()" class="btn btn-primary"
        style="background: var(--primary-color); color: white; border: none; padding: 0.6rem 1.25rem; border-radius: var(--radius-md); font-weight: 600; cursor: pointer; display: flex; align-items: center; gap: 0.5rem;">
        <span>🖨️</span><span>Imprimir Carnet CR-80</span>
      </button>
    </div>
  </div>

  <style>
    /* Estilos de Carnet CR-80 (85.6mm x 53.98mm) */
    .cards-container {
      display: flex;
      flex-wrap: wrap;
      gap: 2rem;
      justify-content: center;
      margin: 2rem 0;
    }
    .cr80-card {
      width: 85.6mm;
      height: 54mm;
      background: white;
      border-radius: 4mm;
      border: 1px solid #cbd5e1;
      box-shadow: 0 10px 25px -5px rgba(0,0,0,0.1), 0 8px 10px -6px rgba(0,0,0,0.1);
      position: relative;
      overflow: hidden;
      display: flex;
      flex-direction: column;
      box-sizing: border-box;
      user-select: none;
    }

    /* Cintillo tricolor superior */
    .card-banner {
      height: 6mm;
      display: flex;
      flex-direction: column;
    }
    .card-banner .band-yellow { height: 2mm; background: #facc15; }
    .card-banner .band-blue { height: 2mm; background: #1d4ed8; }
    .card-banner .band-red { height: 2mm; background: #dc2626; }

    .card-header-brand {
      padding: 1.5mm 3mm 0.5mm 3mm;
      text-align: center;
      border-bottom: 0.5px solid #e2e8f0;
      background: #f8fafc;
    }
    .card-header-brand h4 {
      margin: 0;
      font-size: 7pt;
      font-weight: 800;
      color: #0f172a;
      letter-spacing: -0.2px;
      text-transform: uppercase;
    }
    .card-header-brand p {
      margin: 0;
      font-size: 5pt;
      color: #64748b;
    }

    /* Cuerpo del anverso */
    .card-front-body {
      display: flex;
      padding: 2.5mm 3mm;
      gap: 3mm;
      flex: 1;
      align-items: center;
    }
    .card-photo {
      width: 22mm;
      height: 27mm;
      background: #e2e8f0;
      border-radius: 2mm;
      border: 1px solid #94a3b8;
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      color: #64748b;
      font-size: 14pt;
      font-weight: bold;
      flex-shrink: 0;
      overflow: hidden;
    }
    .card-info {
      flex: 1;
      display: flex;
      flex-direction: column;
      gap: 1mm;
    }
    .worker-name {
      font-size: 8.5pt;
      font-weight: 800;
      color: #0f172a;
      line-height: 1.1;
      text-transform: uppercase;
    }
    .worker-cedula {
      font-size: 8pt;
      font-weight: 700;
      color: #1e3a8a;
      font-family: monospace;
    }
    .worker-cargo {
      font-size: 6.5pt;
      font-weight: 600;
      color: #334155;
      line-height: 1.1;
    }
    .worker-dept {
      font-size: 5.5pt;
      color: #64748b;
    }

    .card-front-footer {
      height: 4.5mm;
      background: #1e3a8a;
      color: white;
      display: flex;
      align-items: center;
      justify-content: space-between;
      padding: 0 3mm;
      font-size: 5pt;
      font-weight: 600;
    }

    /* Reverso */
    .card-back-body {
      padding: 3mm;
      display: flex;
      flex-direction: column;
      flex: 1;
      justify-content: space-between;
    }
    .disclaimer {
      font-size: 4.5pt;
      color: #475569;
      line-height: 1.25;
      text-align: justify;
    }
    .back-middle {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 2mm;
      margin-top: 1mm;
    }
    .qr-container {
      width: 22mm;
      height: 22mm;
      display: flex;
      align-items: center;
      justify-content: center;
    }
    .qr-container img {
      width: 100%;
      height: 100%;
      object-fit: contain;
    }
    .back-meta {
      flex: 1;
      font-size: 5pt;
      color: #334155;
      line-height: 1.3;
    }
    .back-signature {
      border-top: 0.5px solid #94a3b8;
      text-align: center;
      padding-top: 0.8mm;
      margin-top: 1mm;
      font-size: 5pt;
      font-weight: 700;
      color: #1e293b;
    }

    @media print {
      body * {
        visibility: hidden;
      }
      .cards-container, .cards-container * {
        visibility: visible;
      }
      .cards-container {
        position: absolute;
        left: 0;
        top: 0;
        margin: 0;
        gap: 10mm;
      }
      .no-print {
        display: none !important;
      }
      @page {
        size: auto;
        margin: 10mm;
      }
    }
  </style>

  <div class="cards-container">
    <!-- ANVERSO -->
    <div>
      <div style="font-size: 0.75rem; font-weight: 700; color: var(--text-muted); margin-bottom: 0.5rem; text-align: center;" class="no-print">
        ANVERSO (FRENTE)
      </div>
      <div class="cr80-card">
        <div class="card-banner">
          <div class="band-yellow"></div>
          <div class="band-blue"></div>
          <div class="band-red"></div>
        </div>
        <div class="card-header-brand">
          <h4>REPÚBLICA BOLIVARIANA DE VENEZUELA</h4>
          <p>{{ instanceName | default("TALENTO HUMANO Y GESTIÓN LABORAL") }}</p>
        </div>
        <div class="card-front-body">
          <div class="card-photo">
            <span>{{ worker.firstName | truncate(1, true, "") }}{{ worker.lastName | truncate(1, true, "") }}</span>
          </div>
          <div class="card-info">
            <div class="worker-name">{{ worker.firstName }} {{ worker.lastName }}</div>
            <div class="worker-cedula">C.I. {{ worker.cedula }}</div>
            <div class="worker-cargo">{{ worker.position }}</div>
            <div class="worker-dept">{{ worker.departmentId }}</div>
          </div>
        </div>
        <div class="card-front-footer">
          <span>IDENTIFICACIÓN LABORAL</span>
          <span>ESTADO: {{ worker.status }}</span>
        </div>
      </div>
    </div>

    <!-- REVERSO -->
    <div>
      <div style="font-size: 0.75rem; font-weight: 700; color: var(--text-muted); margin-bottom: 0.5rem; text-align: center;" class="no-print">
        REVERSO (CÓDIGO QR Y SEGURIDAD)
      </div>
      <div class="cr80-card">
        <div class="card-back-body">
          <div class="disclaimer">
            Esta credencial es propiedad de la institución, personal e intransferible. Acredita al portador como personal activo sujeto a la normativa legal vigente (LOTTT). En caso de extravío comuníquese a la oficina de Gestión Humana.
          </div>
          <div class="back-middle">
            <div class="qr-container">
              <img src="{{ qrDataUrl }}" alt="QR Verificación">
            </div>
            <div class="back-meta">
              <div><strong>Vigencia:</strong> {{ credential.expiresAt | truncate(10, true, "") }}</div>
              <div><strong>Emitido:</strong> {{ credential.issuedAt | truncate(10, true, "") }}</div>
              <div><strong>ID Seguridad:</strong> {{ credential.token | truncate(12, true, "...") }}</div>
              <div style="margin-top: 1mm; font-size: 4.5pt; color: #64748b;">Escanee para verificar vigencia</div>
            </div>
          </div>
          <div class="back-signature">
            AUTORIZACIÓN GESTIÓN HUMANA &bull; FIRMA DIGITAL
          </div>
        </div>
      </div>
    </div>
  </div>

  <div class="card no-print" style="margin-top: 2rem; background: white; border: 1px solid var(--border-color); border-radius: var(--radius-lg); padding: 1.5rem;">
    <h3 style="font-size: 1rem; font-weight: 600; margin-bottom: 0.5rem; color: var(--text-color);">Verificación en línea directa</h3>
    <p style="font-size: 0.85rem; color: var(--text-muted); margin-bottom: 0.75rem;">
      Enlace público codificado en el código QR para validación instantánea por supervisores o autoridades:
    </p>
    <a href="{{ verificationUrl }}" target="_blank" style="font-family: monospace; font-size: 0.85rem; word-break: break-all; color: var(--primary-light); text-decoration: underline;">
      {{ verificationUrl }}
    </a>
  </div>
</div>
{% endblock %}
