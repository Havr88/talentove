{% extends "layouts/base.njk" %}

{% block content %}
<div>
  <!-- Encabezado de Página -->
  <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 2rem; flex-wrap: wrap; gap: 1rem;">
    <div>
      <h1 style="font-size: 1.85rem; font-weight: 800; color: var(--text-color); letter-spacing: -0.02em;">
        👥 Gestión de Trabajadores (Expedientes de Personal)
      </h1>
      <p style="color: var(--text-muted); font-size: 0.95rem; margin-top: 0.25rem;">
        Padrón laboral, datos de identidad, contratos y cargas familiares.
      </p>
    </div>
    <div style="display: flex; gap: 0.75rem; flex-wrap: wrap;">
      <a href="/trabajadores/importar" class="btn btn-secondary">
        <span>📥</span> Carga Masiva (Excel / CSV)
      </a>
      <a href="/trabajadores/nuevo" class="btn btn-primary">
        <span>➕</span> Nuevo Trabajador
      </a>
    </div>
  </div>

  {% if success %}
    <div class="alert-success">
      <span>✓</span>
      <span>{{ success }}</span>
    </div>
  {% endif %}

  <!-- Contenedor y Filtro de Búsqueda -->
  <div class="table-container">
    <div style="padding: 1.25rem 1.5rem; background: var(--card-bg); border-bottom: 1px solid var(--border-color); display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 1rem;">
      <div style="display: flex; align-items: center; gap: 0.75rem;">
        <span style="font-weight: 700; color: var(--text-color); font-size: 1rem;">Plantilla Registrada</span>
        <span class="badge badge-info">{{ employees.length }} trabajadores</span>
      </div>
      <form method="GET" action="/trabajadores" style="display: flex; gap: 0.5rem; align-items: center;">
        <input type="text" name="q" value="{{ query | default('') }}" class="form-control" style="width: 280px; padding: 0.45rem 0.75rem; font-size: 0.88rem;" placeholder="Buscar por cédula o nombre...">
        <button type="submit" class="btn btn-primary btn-sm">Buscar</button>
        {% if query %}
          <a href="/trabajadores" class="btn btn-outline btn-sm">Limpiar</a>
        {% endif %}
      </form>
    </div>

    <table class="data-table">
      <thead>
        <tr>
          <th style="width: 130px;">Cédula (V/E)</th>
          <th>Trabajador</th>
          <th>Estado Civil</th>
          <th>Contacto</th>
          <th style="width: 130px; text-align: center;">Estatus</th>
          <th style="text-align: right; width: 150px;">Acciones</th>
        </tr>
      </thead>
      <tbody>
        {% if employees.length === 0 %}
          <tr>
            <td colspan="6" style="padding: 3.5rem; text-align: center; color: var(--text-muted);">
              <div style="font-size: 2rem; margin-bottom: 0.5rem;">🔍</div>
              <p style="font-weight: 500;">No hay trabajadores registrados aún. Usa "Nuevo Trabajador" o la "Carga Masiva".</p>
            </td>
          </tr>
        {% endif %}
        {% for emp in employees %}
          <tr>
            <td style="font-weight: 700; color: var(--primary-color); white-space: nowrap;">
              {{ emp.nativeId }}
            </td>
            <td>
              <div style="display: flex; align-items: center; gap: 0.75rem;">
                <div style="width: 34px; height: 34px; border-radius: 50%; background: var(--primary-subtle); color: var(--primary-color); display: flex; align-items: center; justify-content: center; font-weight: 700; font-size: 0.85rem; flex-shrink: 0;">
                  {{ emp.nombres | truncate(1, true, "") | upper }}
                </div>
                <div>
                  <div style="font-weight: 600; color: var(--text-color);">{{ emp.nombres }} {{ emp.apellidos }}</div>
                  <small style="color: var(--text-muted); font-size: 0.78rem;">Ficha Personal #{{ emp.id | truncate(8, true, "") }}</small>
                </div>
              </div>
            </td>
            <td style="text-transform: capitalize; color: var(--text-muted);">
              {{ emp.estadoCivil }}
            </td>
            <td style="color: var(--text-muted); font-size: 0.85rem;">
              {{ emp.correo | default(emp.telefono | default("—")) }}
            </td>
            <td style="text-align: center;">
              {% if emp.status == "activo" %}
                <span class="badge badge-success"><span class="badge-dot"></span> Activo</span>
              {% elif emp.status == "suspendido" %}
                <span class="badge badge-warning"><span class="badge-dot"></span> Suspendido</span>
              {% else %}
                <span class="badge badge-neutral"><span class="badge-dot"></span> {{ emp.status }}</span>
              {% endif %}
            </td>
            <td style="text-align: right;">
              <a href="/trabajadores/{{ emp.id }}" class="btn btn-outline btn-sm" style="font-weight: 600;">
                Expediente &rarr;
              </a>
            </td>
          </tr>
        {% endfor %}
      </tbody>
    </table>
  </div>
</div>
{% endblock %}
