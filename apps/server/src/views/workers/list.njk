{% extends "layouts/base.njk" %}

{% block content %}
<div>
  <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 2rem;">
    <div>
      <h1 style="font-size: 1.75rem; color: var(--primary-color);">Gestión de Trabajadores</h1>
      <p style="color: var(--text-muted);">Listado y expediente del personal activo y registrado</p>
    </div>
    <div style="display: flex; gap: 0.75rem;">
      <a href="/trabajadores/importar" class="btn" style="background-color: #37474f;">📥 Carga Masiva (Excel / CSV)</a>
      <a href="/trabajadores/nuevo" class="btn">➕ Nuevo Trabajador</a>
    </div>
  </div>

  {% if success %}
    <div class="alert-success">{{ success }}</div>
  {% endif %}

  <div class="card" style="padding: 0; overflow: hidden;">
    <div style="padding: 1rem 1.5rem; background: #fafafa; border-bottom: 1px solid var(--border-color); display: flex; justify-content: space-between; align-items: center;">
      <span style="font-weight: 600; color: var(--text-color);">Total: {{ employees.length }} trabajadores</span>
      <form method="GET" action="/trabajadores" style="display: flex; gap: 0.5rem;">
        <input type="text" name="q" value="{{ query | default('') }}" class="form-control" style="width: 250px; padding: 0.35rem 0.65rem;" placeholder="Buscar por cédula o nombre...">
        <button type="submit" class="btn" style="padding: 0.35rem 0.85rem;">Buscar</button>
      </form>
    </div>

    <table style="width: 100%; border-collapse: collapse; text-align: left; font-size: 0.95rem;">
      <thead>
        <tr style="background-color: #f5f5f5; border-bottom: 1px solid var(--border-color);">
          <th style="padding: 0.85rem 1.25rem;">Cédula</th>
          <th style="padding: 0.85rem 1.25rem;">Nombre Completo</th>
          <th style="padding: 0.85rem 1.25rem;">Estado Civil</th>
          <th style="padding: 0.85rem 1.25rem;">Contacto</th>
          <th style="padding: 0.85rem 1.25rem;">Estatus</th>
          <th style="padding: 0.85rem 1.25rem; text-align: right;">Acciones</th>
        </tr>
      </thead>
      <tbody>
        {% if employees.length === 0 %}
          <tr>
            <td colspan="6" style="padding: 2.5rem; text-align: center; color: var(--text-muted);">
              No hay trabajadores registrados aún. Usa "Nuevo Trabajador" o la "Carga Masiva".
            </td>
          </tr>
        {% endif %}
        {% for emp in employees %}
          <tr style="border-bottom: 1px solid var(--border-color);">
            <td style="padding: 0.85rem 1.25rem; font-weight: 600; color: var(--primary-color);">{{ emp.nativeId }}</td>
            <td style="padding: 0.85rem 1.25rem;">{{ emp.nombres }} {{ emp.apellidos }}</td>
            <td style="padding: 0.85rem 1.25rem; text-transform: capitalize;">{{ emp.estadoCivil }}</td>
            <td style="padding: 0.85rem 1.25rem; color: var(--text-muted);">{{ emp.correo | default(emp.telefono | default("—")) }}</td>
            <td style="padding: 0.85rem 1.25rem;">
              <span style="display: inline-block; padding: 0.2rem 0.6rem; border-radius: 9999px; font-size: 0.8rem; font-weight: 600; background-color: #e8f5e9; color: #2e7d32;">
                {{ emp.status }}
              </span>
            </td>
            <td style="padding: 0.85rem 1.25rem; text-align: right;">
              <a href="/trabajadores/{{ emp.id }}" style="color: var(--primary-color); font-weight: 600; text-decoration: none;">Ver Expediente &rarr;</a>
            </td>
          </tr>
        {% endfor %}
      </tbody>
    </table>
  </div>
</div>
{% endblock %}
