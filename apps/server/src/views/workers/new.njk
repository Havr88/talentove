{% extends "layouts/base.njk" %}

{% block content %}
<div style="max-width: 800px; margin: 0 auto;">
  <div style="margin-bottom: 1.5rem;">
    <a href="/trabajadores" style="color: var(--text-muted); text-decoration: none;">&larr; Volver al Listado</a>
    <h1 style="font-size: 1.75rem; color: var(--primary-color); margin-top: 0.5rem;">Registrar Nuevo Trabajador</h1>
  </div>

  {% if error %}
    <div class="alert-error">{{ error }}</div>
  {% endif %}

  <div class="card">
    <form action="/trabajadores" method="POST">
      {% if csrfToken %}<input type="hidden" name="_csrf" value="{{ csrfToken }}">{% endif %}

      <h3 style="font-size: 1.1rem; border-bottom: 2px solid var(--border-color); padding-bottom: 0.5rem; margin-bottom: 1.25rem;">1. Identificación y Datos Personales</h3>

      <div style="display: grid; grid-template-columns: 1fr 2fr 2fr; gap: 1rem;">
        <div class="form-group">
          <label for="cedulaTipo">Tipo *</label>
          <select id="cedulaTipo" name="cedulaTipo" class="form-control" required>
            <option value="V" {% if values.cedulaTipo == 'V' %}selected{% endif %}>V (Venezolano)</option>
            <option value="E" {% if values.cedulaTipo == 'E' %}selected{% endif %}>E (Extranjero)</option>
          </select>
        </div>
        <div class="form-group">
          <label for="cedulaNumero">Cédula de Identidad *</label>
          <input type="text" id="cedulaNumero" name="cedulaNumero" class="form-control" required value="{{ values.cedulaNumero | default('') }}" placeholder="12345678">
        </div>
        <div class="form-group">
          <label for="rif">RIF (Opcional)</label>
          <input type="text" id="rif" name="rif" class="form-control" value="{{ values.rif | default('') }}" placeholder="V-12345678-0">
        </div>
      </div>

      <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 1rem;">
        <div class="form-group">
          <label for="nombres">Nombres *</label>
          <input type="text" id="nombres" name="nombres" class="form-control" required value="{{ values.nombres | default('') }}">
        </div>
        <div class="form-group">
          <label for="apellidos">Apellidos *</label>
          <input type="text" id="apellidos" name="apellidos" class="form-control" required value="{{ values.apellidos | default('') }}">
        </div>
      </div>

      <div style="display: grid; grid-template-columns: 1fr 1fr 1fr; gap: 1rem;">
        <div class="form-group">
          <label for="fechaNacimiento">Fecha de Nacimiento *</label>
          <input type="date" id="fechaNacimiento" name="fechaNacimiento" class="form-control" required value="{{ values.fechaNacimiento | default('') }}">
        </div>
        <div class="form-group">
          <label for="sexo">Sexo *</label>
          <select id="sexo" name="sexo" class="form-control" required>
            <option value="M" {% if values.sexo == 'M' %}selected{% endif %}>Masculino</option>
            <option value="F" {% if values.sexo == 'F' %}selected{% endif %}>Femenino</option>
          </select>
        </div>
        <div class="form-group">
          <label for="estadoCivil">Estado Civil *</label>
          <select id="estadoCivil" name="estadoCivil" class="form-control" required>
            <option value="soltero">Soltero/a</option>
            <option value="casado">Casado/a</option>
            <option value="divorciado">Divorciado/a</option>
            <option value="viudo">Viudo/a</option>
            <option value="union_estable">Unión Estable de Hechos</option>
          </select>
        </div>
      </div>

      <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 1rem;">
        <div class="form-group">
          <label for="correo">Correo Electrónico</label>
          <input type="email" id="correo" name="correo" class="form-control" value="{{ values.correo | default('') }}">
        </div>
        <div class="form-group">
          <label for="telefono">Teléfono de Contacto</label>
          <input type="text" id="telefono" name="telefono" class="form-control" value="{{ values.telefono | default('') }}" placeholder="+58 412-1234567">
        </div>
      </div>

      <div style="display: grid; grid-template-columns: 1fr 2fr; gap: 1rem;">
        <div class="form-group">
          <label for="territoryId">Entidad Federal (Estado) *</label>
          <select id="territoryId" name="territoryId" class="form-control" required>
            {% for t in territories %}
              <option value="{{ t.id }}">{{ t.nombre }}</option>
            {% endfor %}
          </select>
        </div>
        <div class="form-group">
          <label for="direccion">Dirección de Habitación *</label>
          <input type="text" id="direccion" name="direccion" class="form-control" required value="{{ values.direccion | default('') }}" placeholder="Municipio, sector, calle, edificio...">
        </div>
      </div>

      <h3 style="font-size: 1.1rem; border-bottom: 2px solid var(--border-color); padding-bottom: 0.5rem; margin-top: 2rem; margin-bottom: 1.25rem;">2. Contrato y Relación Laboral</h3>

      <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 1rem;">
        <div class="form-group">
          <label for="cargo">Denominación del Cargo *</label>
          <input type="text" id="cargo" name="cargo" class="form-control" required value="{{ values.cargo | default('') }}" placeholder="Ej. Analista de Nómina">
        </div>
        <div class="form-group">
          <label for="unidad">Unidad Organizativa / Departamento *</label>
          <input type="text" id="unidad" name="unidad" class="form-control" required value="{{ values.unidad | default('') }}" placeholder="Ej. Recursos Humanos">
        </div>
      </div>

      <div style="display: grid; grid-template-columns: 1fr 1fr 1fr; gap: 1rem;">
        <div class="form-group">
          <label for="sector">Régimen / Sector *</label>
          <select id="sector" name="sector" class="form-control" required>
            <option value="privado" {% if values.sector == 'privado' %}selected{% endif %}>Sector Privado (LOTTT)</option>
            <option value="publico" {% if values.sector == 'publico' %}selected{% endif %}>Sector Público (Estatutario / APN)</option>
          </select>
        </div>
        <div class="form-group">
          <label for="tipoContrato">Tipo de Contrato *</label>
          <select id="tipoContrato" name="tipoContrato" class="form-control" required>
            <option value="indeterminado">Tiempo Indeterminado</option>
            <option value="determinado">Tiempo Determinado</option>
            <option value="obra_labor">Para una Obra Determinada</option>
          </select>
        </div>
        <div class="form-group">
          <label for="fechaIngreso">Fecha de Ingreso *</label>
          <input type="date" id="fechaIngreso" name="fechaIngreso" class="form-control" required value="{{ values.fechaIngreso | default('') }}">
        </div>
      </div>

      <div style="display: grid; grid-template-columns: 2fr 1fr; gap: 1rem;">
        <div class="form-group">
          <label for="salario">Salario Base Mensual *</label>
          <input type="text" id="salario" name="salario" class="form-control" required value="{{ values.salario | default('') }}" placeholder="0.00">
        </div>
        <div class="form-group">
          <label for="moneda">Moneda *</label>
          <select id="moneda" name="moneda" class="form-control" required>
            <option value="VES">Bolívares (VES)</option>
            <option value="USD">Dólares (USD)</option>
          </select>
        </div>
      </div>

      <div style="margin-top: 2rem; display: flex; justify-content: flex-end; gap: 0.75rem;">
        <a href="/trabajadores" class="btn btn-outline">Cancelar</a>
        <button type="submit" class="btn btn-primary">Guardar Trabajador y Crear Expediente</button>
      </div>
    </form>
  </div>
</div>
{% endblock %}
