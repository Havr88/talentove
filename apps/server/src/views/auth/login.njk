{% extends "layouts/base.njk" %}

{% block content %}
<div style="max-width: 440px; margin: 3.5rem auto;">
  <div class="card" style="box-shadow: var(--shadow-lg); padding: 2rem;">
    <div style="text-align: center; margin-bottom: 2rem;">
      <div style="display: inline-flex; align-items: center; justify-content: center; width: 56px; height: 56px; border-radius: var(--radius-lg); background: var(--primary-subtle); font-size: 1.8rem; margin-bottom: 1rem; border: 1px solid var(--border-color);">
        🇻🇪
      </div>
      <h1 style="font-size: 1.6rem; font-weight: 800; color: var(--text-color); letter-spacing: -0.02em; margin-bottom: 0.25rem;">
        Iniciar Sesión
      </h1>
      <p style="color: var(--text-muted); font-size: 0.88rem;">
        Sistema Integral de Recursos Humanos y Nómina LOTTT
      </p>
    </div>

    {% if error %}
      <div class="alert-error">
        <span>⚠️</span>
        <span>{{ error }}</span>
      </div>
    {% endif %}

    <form action="/auth/login" method="POST">
      {% if csrfToken %}<input type="hidden" name="_csrf" value="{{ csrfToken }}">{% endif %}

      <div class="form-group">
        <label for="email">Correo Electrónico</label>
        <input type="email" id="email" name="email" class="form-control" required autocomplete="email" placeholder="usuario@empresa.gob.ve" value="{{ email | default('') }}">
      </div>

      <div class="form-group" style="margin-bottom: 1.75rem;">
        <label for="password">Contraseña</label>
        <input type="password" id="password" name="password" class="form-control" required autocomplete="current-password" placeholder="••••••••">
      </div>

      <button type="submit" class="btn btn-primary" style="width: 100%; padding: 0.75rem 1rem; font-size: 0.95rem;">
        Ingresar al Sistema
      </button>
    </form>

    <div style="margin-top: 1.75rem; padding-top: 1.25rem; border-top: 1px solid var(--border-color); text-align: center;">
      <small style="color: var(--text-muted); font-size: 0.8rem;">
        🔒 Conexión segura &bull; Cumplimiento normativo LOTTT
      </small>
    </div>
  </div>
</div>
{% endblock %}
