{% extends "layouts/base.njk" %}

{% block content %}
<div style="max-width: 420px; margin: 3rem auto;">
  <div class="card">
    <div style="text-align: center; margin-bottom: 1.5rem;">
      <h2 style="font-size: 1.5rem; color: var(--primary-color);">Iniciar Sesión</h2>
      <p style="color: var(--text-muted); font-size: 0.875rem;">Accede a tu cuenta de {{ instanceName | default("TalentoVe") }}</p>
    </div>

    {% if error %}
      <div class="alert-error">{{ error }}</div>
    {% endif %}

    <form action="/auth/login" method="POST">
      <div class="form-group">
        <label for="email">Correo Electrónico</label>
        <input type="email" id="email" name="email" class="form-control" required placeholder="usuario@empresa.ve" value="{{ email | default('') }}">
      </div>

      <div class="form-group">
        <label for="password">Contraseña</label>
        <input type="password" id="password" name="password" class="form-control" required placeholder="••••••••">
      </div>

      <button type="submit" class="btn" style="width: 100%; margin-top: 1rem;">Ingresar al Sistema</button>
    </form>
  </div>
</div>
{% endblock %}
