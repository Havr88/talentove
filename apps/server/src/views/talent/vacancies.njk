{% extends "layouts/base.njk" %}

{% block content %}
<div class="row">
  <div class="col s12">
    <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 24px;">
      <div>
        <h4 style="margin: 0; font-weight: 700; color: #1a237e;">Atracción y Selección (ATS)</h4>
        <p style="margin: 4px 0 0; color: #546e7a;">Convocatorias laborales, pipeline Kanban y captación de talento</p>
      </div>
      <div>
        <a href="#modal-nueva-vacante" class="btn waves-effect waves-light modal-trigger" style="background-color: #1565c0; border-radius: 6px;">
          <i class="material-icons left">add_circle</i>Publicar Vacante
        </a>
      </div>
    </div>
  </div>

  <div class="col s12">
    <div class="card z-depth-1" style="border-radius: 8px;">
      <div class="card-content" style="padding: 24px;">
        <span class="card-title" style="font-weight: 600; font-size: 1.2rem; color: #263238; margin-bottom: 20px;">
          <i class="material-icons left" style="color: #1565c0;">work</i>Convocatorias de Empleo Activas
        </span>

        <table class="striped highlight responsive-table">
          <thead>
            <tr style="border-bottom: 2px solid #cfd8dc;">
              <th>Código</th>
              <th>Título del Cargo</th>
              <th>Departamento</th>
              <th>Tipo</th>
              <th>Vacantes</th>
              <th>Estado</th>
              <th>Acciones</th>
            </tr>
          </thead>
          <tbody>
            {% if postings.length > 0 %}
              {% for p in postings %}
              <tr>
                <td><span class="chip blue lighten-5 blue-text text-darken-3" style="font-weight: 600;">{{ p.code }}</span></td>
                <td style="font-weight: 600; color: #37474f;">{{ p.title }}</td>
                <td>{{ p.departmentName }}</td>
                <td>
                  {% if p.type == 'publica' %}
                    <span class="chip teal lighten-5 teal-text text-darken-3">Pública</span>
                  {% elif p.type == 'interna' %}
                    <span class="chip orange lighten-5 orange-text text-darken-3">Interna</span>
                  {% else %}
                    <span class="chip purple lighten-5 purple-text text-darken-3">Mixta</span>
                  {% endif %}
                </td>
                <td>{{ p.vacanciesCount }} puestos</td>
                <td>
                  {% if p.status == 'publicada' %}
                    <span class="chip green lighten-4 green-text text-darken-4">Publicada</span>
                  {% else %}
                    <span class="chip grey lighten-3">{{ p.status | upper }}</span>
                  {% endif %}
                </td>
                <td>
                  <a href="/talento/postulaciones/{{ p.id }}" class="btn-small waves-effect waves-light blue darken-3" style="border-radius: 4px;">
                    <i class="material-icons left">view_kanban</i>Tablero Kanban
                  </a>
                </td>
              </tr>
              {% endfor %}
            {% else %}
              <tr>
                <td colspan="7" class="center-align grey-text" style="padding: 32px;">
                  No hay convocatorias laborales abiertas actualmente.
                </td>
              </tr>
            {% endif %}
          </tbody>
        </table>
      </div>
    </div>
  </div>
</div>

<!-- Modal Nueva Vacante -->
<div id="modal-nueva-vacante" class="modal modal-fixed-footer" style="border-radius: 8px; max-width: 700px;">
  <form action="/talento/vacantes" method="POST">
    <div class="modal-content">
      <h5 style="font-weight: 700; color: #1a237e; margin-top: 0;">Publicar Convocatoria Laboral</h5>
      <div class="row">
        <div class="input-field col s12 m4">
          <input id="code" name="code" type="text" required placeholder="p.ej. VAC-2026-001" class="validate">
          <label for="code" class="active">Código de Vacante</label>
        </div>
        <div class="input-field col s12 m8">
          <input id="title" name="title" type="text" required placeholder="Título del puesto de trabajo" class="validate">
          <label for="title" class="active">Título de la Convocatoria</label>
        </div>

        <div class="input-field col s12 m6">
          <label class="active" style="transform: translateY(-24px);">Departamento / Unidad</label>
          <select name="orgUnitId" class="browser-default" style="margin-top: 8px; border: 1px solid #cfd8dc; border-radius: 4px; padding: 8px;" required>
            {% for o in orgUnits %}
            <option value="{{ o.id }}">{{ o.name }}</option>
            {% endfor %}
          </select>
        </div>

        <div class="input-field col s12 m6">
          <label class="active" style="transform: translateY(-24px);">Cargo Asignado</label>
          <select name="positionId" class="browser-default" style="margin-top: 8px; border: 1px solid #cfd8dc; border-radius: 4px; padding: 8px;" required>
            {% for p in positions %}
            <option value="{{ p.id }}">{{ p.name }}</option>
            {% endfor %}
          </select>
        </div>

        <div class="input-field col s12 m4">
          <label class="active" style="transform: translateY(-24px);">Tipo de Publicación</label>
          <select name="type" class="browser-default" style="margin-top: 8px; border: 1px solid #cfd8dc; border-radius: 4px; padding: 8px;">
            <option value="publica" selected>Pública (Externa)</option>
            <option value="interna">Interna (Promoción)</option>
            <option value="mixta">Mixta</option>
          </select>
        </div>

        <div class="input-field col s12 m4">
          <input id="vacanciesCount" name="vacanciesCount" type="number" min="1" value="1" required class="validate">
          <label for="vacanciesCount" class="active">Nro. de Puestos</label>
        </div>

        <div class="input-field col s12 m4">
          <input id="salaryMinBs" name="salaryMinBs" type="text" placeholder="Ej. 3000.00" class="validate">
          <label for="salaryMinBs" class="active">Salario Oferta (Bs.)</label>
        </div>

        <div class="input-field col s12">
          <textarea id="description" name="description" class="materialize-textarea" placeholder="Descripción general de responsabilidades del cargo"></textarea>
          <label for="description" class="active">Descripción del Perfil</label>
        </div>
      </div>
    </div>
    <div class="modal-footer" style="padding: 0 24px 20px;">
      <a href="#!" class="modal-close btn-flat grey-text">Cancelar</a>
      <button type="submit" class="btn waves-effect waves-light" style="background-color: #1565c0; border-radius: 6px;">Guardar y Publicar</button>
    </div>
  </form>
</div>
{% endblock %}
