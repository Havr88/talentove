{% extends "layouts/base.njk" %}

{% block content %}
<div class="page-header">
  <div class="page-header-content">
    <div class="page-header-icon">📑</div>
    <div>
      <h1 class="page-header-title">Historial de Solicitudes y Permisos</h1>
      <p class="page-header-subtitle">Seguimiento en tiempo real de tus trámites de vacaciones, permisos y anticipos.</p>
    </div>
  </div>
  <div class="page-header-actions">
    <a href="/mi-portal" class="btn btn-secondary">&larr; Volver al Portal</a>
  </div>
</div>

<div class="card">
  <div class="card-header">
    <h3 class="card-title">Todas mis Solicitudes</h3>
    <a href="/mi-portal" class="btn btn-sm btn-primary">+ Nueva Solicitud</a>
  </div>

  {% if requests and requests.length > 0 %}
    <div class="table-responsive">
      <table class="qrh-table">
        <thead>
          <tr>
            <th>Código</th>
            <th>Tipo de Trámite</th>
            <th>Período Solicitado</th>
            <th>Días Hábiles</th>
            <th>Motivo</th>
            <th>Estatus</th>
            <th>Fecha Registro</th>
          </tr>
        </thead>
        <tbody>
          {% for req in requests %}
          <tr>
            <td style="font-family: monospace; font-size: 0.8rem; font-weight: 600;">{{ req.id | truncate(10, true, "") }}</td>
            <td style="font-weight: 700;">{{ req.tipo }}</td>
            <td>{{ req.fechaDesde }} al {{ req.fechaHasta }}</td>
            <td>{{ req.diasSolicitados | default(1) }}</td>
            <td>{{ req.motivo }}</td>
            <td>
              {% if req.estatus == "aprobada" or req.estatus == "APROBADO" %}
                <span class="badge" style="background: #dcfce7; color: #16a34a; padding: 0.25rem 0.65rem; border-radius: 9999px; font-weight: 700; font-size: 0.75rem;">Aprobada ✓</span>
              {% elif req.estatus == "rechazada" or req.estatus == "RECHAZADO" %}
                <span class="badge" style="background: #fee2e2; color: #dc2626; padding: 0.25rem 0.65rem; border-radius: 9999px; font-weight: 700; font-size: 0.75rem;">Rechazada ✕</span>
              {% else %}
                <span class="badge" style="background: #fef3c7; color: #d97706; padding: 0.25rem 0.65rem; border-radius: 9999px; font-weight: 700; font-size: 0.75rem;">Pendiente ⏳</span>
              {% endif %}
            </td>
            <td style="color: var(--text-muted); font-size: 0.8rem;">{{ req.createdAt }}</td>
          </tr>
          {% endfor %}
        </tbody>
      </table>
    </div>
  {% else %}
    <div style="text-align: center; padding: 3rem 1rem;">
      <div style="font-size: 2.5rem; margin-bottom: 0.75rem;">📝</div>
      <h4 style="font-size: 1.1rem; font-weight: 700; margin-bottom: 0.25rem;">No tienes solicitudes registradas</h4>
      <p style="color: var(--text-muted); font-size: 0.875rem;">Puedes emitir solicitudes de vacaciones, permisos o anticipos desde el panel principal de tu portal.</p>
    </div>
  {% endif %}
</div>
{% endblock %}
