{% extends "layouts/base.njk" %}

{% block content %}
<div>
  <div style="margin-bottom: 2rem;">
    <h1 style="font-size: 1.75rem; color: var(--primary-color);">Bienvenido, {{ currentUser.fullName }}</h1>
    <p style="color: var(--text-muted);">{{ settings.companyName }} &bull; RIF: {{ settings.nativeId }}</p>
  </div>

  <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(240px, 1fr)); gap: 1.5rem; margin-bottom: 2rem;">
    <div class="card">
      <h3 style="font-size: 0.9rem; text-transform: uppercase; color: var(--text-muted); margin-bottom: 0.5rem;">Trabajadores</h3>
      <p style="font-size: 2rem; font-weight: 700; color: var(--primary-color);">{{ workerCount | default(0) }}</p>
      <small style="color: var(--text-muted);">Total plantilla activa</small>
    </div>

    <div class="card">
      <h3 style="font-size: 0.9rem; text-transform: uppercase; color: var(--text-muted); margin-bottom: 0.5rem;">Tasa Oficial BCV</h3>
      <p style="font-size: 1.5rem; font-weight: 700; color: #2e7d32;">{{ bcvRate | default("No sincronizada") }}</p>
      <small style="color: var(--text-muted);">Bs. / USD</small>
    </div>

    <div class="card">
      <h3 style="font-size: 0.9rem; text-transform: uppercase; color: var(--text-muted); margin-bottom: 0.5rem;">Próxima Nómina</h3>
      <p style="font-size: 1.25rem; font-weight: 600;">1ra Quincena</p>
      <small style="color: var(--text-muted);">Periodo regular</small>
    </div>
  </div>

  <div class="card">
    <h2 style="font-size: 1.25rem; margin-bottom: 1rem;">Módulos del Sistema</h2>
    <p style="color: var(--text-muted); margin-bottom: 1.5rem;">
      TalentoVe está en fase de desarrollo (M0). El núcleo de dominio, las tasas de cambio y el sistema de instalación y autenticación están operativos.
    </p>
    <div style="display: flex; gap: 1rem; flex-wrap: wrap;">
      <a href="/trabajadores" class="btn">Expediente de Personal (M1a)</a>
      <a href="/solicitudes" class="btn" style="background-color: #455a64;">Portal de Solicitudes (M1b)</a>
      <a href="/nomina" class="btn" style="background-color: #37474f;">Nómina Venezolana (M2a)</a>
    </div>
  </div>
</div>
{% endblock %}
